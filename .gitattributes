# Derived from qsm.json by lib/generate-noun.ts and proven fresh by the generated gate.
# export-ignore keeps them out of what qsm-langdev scores, as the root spec asks: tools leave
# generated files to the generator.
plugins/*/hooks/noun.generated.ts export-ignore linguist-generated=true
plugins/*/hooks/host.generated.ts export-ignore linguist-generated=true
plugins/*/types/index.d.ts linguist-generated=true
# Rendered, locked or exported by a tool, so a reviewer never reads them and the pr-size check
# does not count them.
models/*.svg linguist-generated=true
bun.lock linguist-generated=true
plugins/*/bun.lock linguist-generated=true
.beads/issues.jsonl linguist-generated=true
# Most of a BPMN diff is the layout qsm-bpmn writes; a reviewer reads the model through its picture.
models/*.bpmn linguist-generated=true
