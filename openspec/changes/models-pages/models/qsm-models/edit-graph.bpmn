      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_say" bpmnElement="say" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="2603.1000000000004" y="716" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_open_end" bpmnElement="open_end" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff">
        <dc:Bounds x="2861.9" y="738" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2845.0750000000003" y="790.1" width="71" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_start_open" bpmnElement="f_start_open" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="216.8" y="236" /><di:waypoint x="375.6" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_open_editJoin" bpmnElement="f_open_editJoin" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="475.6" y="236" /><di:waypoint x="636.85" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_editJoin_edit" bpmnElement="f_editJoin_edit" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="686.85" y="236" /><di:waypoint x="848.1" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_edit_legal" bpmnElement="f_edit_legal" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="948.1" y="236" /><di:waypoint x="1109.3500000000001" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_legal_save" bpmnElement="f_legal_save" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1159.3500000000001" y="236" /><di:waypoint x="1320.6000000000001" y="236" /><bpmndi:BPMNLabel><dc:Bounds x="1223.775" y="209.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_save_read" bpmnElement="f_save_read" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1420.6000000000001" y="236" /><di:waypoint x="1640.6000000000001" y="236" /><di:waypoint x="1640.6000000000001" y="508" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_read_apply" bpmnElement="f_read_apply" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1690.6000000000001" y="548" /><di:waypoint x="1860.6000000000001" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_apply_gates" bpmnElement="f_apply_gates" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1960.6000000000001" y="548" /><di:waypoint x="2130.6000000000004" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_gates_pass" bpmnElement="f_gates_pass" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="2230.6000000000004" y="548" /><di:waypoint x="2391.8500000000004" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_pass_create" bpmnElement="f_pass_create" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="2441.8500000000004" y="548" /><di:waypoint x="2603.1000000000004" y="548" /><bpmndi:BPMNLabel><dc:Bounds x="2506.275" y="521.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
