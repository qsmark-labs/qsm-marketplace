      <bpmndi:BPMNEdge id="BPMNEdge_f_say_open_end" bpmnElement="f_say_open_end" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="2703.1000000000004" y="756" /><di:waypoint x="2861.9" y="756" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_legal_editJoin" bpmnElement="f_legal_editJoin" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1134.3500000000001" y="261" /><di:waypoint x="1134.3500000000001" y="314" /><di:waypoint x="661.85" y="314" /><di:waypoint x="661.85" y="261" /><bpmndi:BPMNLabel><dc:Bounds x="856.2750000000001" y="326.5" width="85" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
