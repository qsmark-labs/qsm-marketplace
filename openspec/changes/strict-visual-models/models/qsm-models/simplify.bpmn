        <dc:Bounds x="786" y="531" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_againMore" bpmnElement="againMore" bioc:stroke="#0f766e" bioc:fill="#d9f2ef" color:border-color="#0f766e" color:background-color="#d9f2ef" isMarkerVisible="true">
        <dc:Bounds x="936" y="531" width="50" height="50" />
