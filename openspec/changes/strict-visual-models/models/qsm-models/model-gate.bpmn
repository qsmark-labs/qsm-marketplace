        <bpmndi:BPMNLabel>
          <dc:Bounds x="3060" y="863" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_start_writeJoin" bpmnElement="f_start_writeJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb">
        <di:waypoint x="186" y="200" />
