        <bpmndi:BPMNLabel>
          <dc:Bounds x="1474" y="178" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_specJoin_paths" bpmnElement="f_specJoin_paths" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb">
        <di:waypoint x="1586" y="200" />
        <di:waypoint x="1686" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_paths_covered" bpmnElement="f_paths_covered" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb">
        <di:waypoint x="1786" y="200" />
        <di:waypoint x="1886" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_covered_commit" bpmnElement="f_covered_commit" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb">
        <di:waypoint x="1936" y="200" />
        <di:waypoint x="2036" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1974" y="178" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_commit_gateOk" bpmnElement="f_commit_gateOk" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb">
        <di:waypoint x="2136" y="200" />
        <di:waypoint x="2236" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_gateOk_review" bpmnElement="f_gateOk_review" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb">
        <di:waypoint x="2286" y="200" />
        <di:waypoint x="2436" y="200" />
        <di:waypoint x="2436" y="560" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2349" y="178" width="25" height="14" />
