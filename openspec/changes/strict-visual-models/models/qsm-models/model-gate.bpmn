      <bpmndi:BPMNEdge id="BPMNEdge_f_lint_lintOk" bpmnElement="f_lint_lintOk" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="948.1" y="236" /><di:waypoint x="1109.3500000000001" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_lintOk_render" bpmnElement="f_lintOk_render" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1159.3500000000001" y="236" /><di:waypoint x="1320.6000000000001" y="236" /><bpmndi:BPMNLabel><dc:Bounds x="1223.775" y="209.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
