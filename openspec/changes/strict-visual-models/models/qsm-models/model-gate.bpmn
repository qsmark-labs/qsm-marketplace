      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_covered" bpmnElement="covered" bioc:stroke="#6b4fbb" bioc:fill="#ebe5fa" color:border-color="#6b4fbb" color:background-color="#ebe5fa" isMarkerVisible="true">
        <dc:Bounds x="1886" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1871" y="142" width="80" height="28" />
