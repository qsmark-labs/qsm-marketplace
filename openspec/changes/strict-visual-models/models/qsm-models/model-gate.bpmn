        <di:waypoint x="1286" y="200" />
        <di:waypoint x="1386" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_readable_specJoin" bpmnElement="f_readable_specJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb">
