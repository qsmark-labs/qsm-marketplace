      <bpmndi:BPMNShape id="BPMNShape_readable" bpmnElement="readable" bioc:stroke="#6b4fbb" bioc:fill="#ebe5fa" color:border-color="#6b4fbb" color:background-color="#ebe5fa" isMarkerVisible="true">
        <dc:Bounds x="1386" y="175" width="50" height="50" />
