      <bpmndi:BPMNEdge id="BPMNEdge_f_start_writeJoin" bpmnElement="f_start_writeJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="216.8" y="236" /><di:waypoint x="366.85" y="236" /></bpmndi:BPMNEdge>
