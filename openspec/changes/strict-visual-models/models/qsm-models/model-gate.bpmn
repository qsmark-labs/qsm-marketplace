<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="model_gate_defs" targetNamespace="https://github.com/qsmark-labs/qsm-marketplace">
  <bpmn:collaboration id="model_gate_collab">
    <bpmn:participant id="model_gate_pool" name="A change to a graph is checked" processRef="model_gate_process" />
  </bpmn:collaboration>
  <bpmn:process id="model_gate_process" name="A change to a graph is checked" isExecutable="false">
    <bpmn:laneSet id="laneset">
      <bpmn:lane id="lane_0" name="Agent">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lintOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>look</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>covered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scenario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>links</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>linksOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Review agent">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="Owner">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Behaviour or structure to change">
      <bpmn:outgoing>f_start_writeJoin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="writeJoin">
      <bpmn:incoming>f_start_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_lintOk_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_readable_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_linksOk_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_gateOk_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_findings_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_clear_writeJoin</bpmn:incoming>
      <bpmn:outgoing>f_writeJoin_write</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="write" name="Edit the graph">
      <bpmn:incoming>f_writeJoin_write</bpmn:incoming>
      <bpmn:outgoing>f_write_lint</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="lint" name="Lint the graph">
      <bpmn:incoming>f_write_lint</bpmn:incoming>
      <bpmn:outgoing>f_lint_lintOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="lintOk" name="Lint clean?">
      <bpmn:incoming>f_lint_lintOk</bpmn:incoming>
      <bpmn:outgoing>f_lintOk_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_lintOk_render</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="render" name="Render the picture">
      <bpmn:incoming>f_lintOk_render</bpmn:incoming>
      <bpmn:outgoing>f_render_look</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="look" name="Look at the picture">
      <bpmn:incoming>f_render_look</bpmn:incoming>
      <bpmn:outgoing>f_look_readable</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="readable" name="Readable?">
      <bpmn:incoming>f_look_readable</bpmn:incoming>
      <bpmn:outgoing>f_readable_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_readable_specJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="specJoin">
      <bpmn:incoming>f_readable_specJoin</bpmn:incoming>
      <bpmn:incoming>f_scenario_specJoin</bpmn:incoming>
      <bpmn:outgoing>f_specJoin_paths</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="paths" name="List the cover paths">
      <bpmn:incoming>f_specJoin_paths</bpmn:incoming>
      <bpmn:outgoing>f_paths_covered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="covered" name="Every cover path cited?">
      <bpmn:incoming>f_paths_covered</bpmn:incoming>
      <bpmn:outgoing>f_covered_scenario</bpmn:outgoing>
      <bpmn:outgoing>f_covered_links</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="scenario" name="Write the scenario for the path">
      <bpmn:incoming>f_covered_scenario</bpmn:incoming>
      <bpmn:outgoing>f_scenario_specJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="links" name="Check the links">
      <bpmn:incoming>f_covered_links</bpmn:incoming>
      <bpmn:outgoing>f_links_linksOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="linksOk" name="Every link resolves?">
      <bpmn:incoming>f_links_linksOk</bpmn:incoming>
      <bpmn:outgoing>f_linksOk_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_linksOk_commit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="commit" name="Commit the graph">
      <bpmn:incoming>f_linksOk_commit</bpmn:incoming>
      <bpmn:outgoing>f_commit_gateOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateOk" name="Gate passes?">
      <bpmn:incoming>f_commit_gateOk</bpmn:incoming>
      <bpmn:outgoing>f_gateOk_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_gateOk_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="review" name="Review the graph and its pictures">
      <bpmn:incoming>f_gateOk_review</bpmn:incoming>
      <bpmn:outgoing>f_review_findings</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="findings" name="Findings?">
      <bpmn:incoming>f_review_findings</bpmn:incoming>
      <bpmn:outgoing>f_findings_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_findings_read</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="read" name="Read the picture">
      <bpmn:incoming>f_findings_read</bpmn:incoming>
      <bpmn:outgoing>f_read_clear</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="clear" name="Clear what we want?">
      <bpmn:incoming>f_read_clear</bpmn:incoming>
      <bpmn:outgoing>f_clear_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_clear_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end" name="Model agreed">
      <bpmn:incoming>f_clear_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_writeJoin" sourceRef="start" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_writeJoin_write" sourceRef="writeJoin" targetRef="write" />
    <bpmn:sequenceFlow id="f_write_lint" sourceRef="write" targetRef="lint" />
    <bpmn:sequenceFlow id="f_lint_lintOk" sourceRef="lint" targetRef="lintOk" />
    <bpmn:sequenceFlow id="f_lintOk_writeJoin" name="no" sourceRef="lintOk" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_lintOk_render" name="yes" sourceRef="lintOk" targetRef="render" />
    <bpmn:sequenceFlow id="f_render_look" sourceRef="render" targetRef="look" />
    <bpmn:sequenceFlow id="f_look_readable" sourceRef="look" targetRef="readable" />
    <bpmn:sequenceFlow id="f_readable_writeJoin" name="no" sourceRef="readable" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_readable_specJoin" name="yes" sourceRef="readable" targetRef="specJoin" />
    <bpmn:sequenceFlow id="f_specJoin_paths" sourceRef="specJoin" targetRef="paths" />
    <bpmn:sequenceFlow id="f_paths_covered" sourceRef="paths" targetRef="covered" />
    <bpmn:sequenceFlow id="f_covered_scenario" name="no" sourceRef="covered" targetRef="scenario" />
    <bpmn:sequenceFlow id="f_covered_links" name="yes" sourceRef="covered" targetRef="links" />
    <bpmn:sequenceFlow id="f_links_linksOk" sourceRef="links" targetRef="linksOk" />
    <bpmn:sequenceFlow id="f_linksOk_writeJoin" name="no" sourceRef="linksOk" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_linksOk_commit" name="yes" sourceRef="linksOk" targetRef="commit" />
    <bpmn:sequenceFlow id="f_scenario_specJoin" sourceRef="scenario" targetRef="specJoin" />
    <bpmn:sequenceFlow id="f_commit_gateOk" sourceRef="commit" targetRef="gateOk" />
    <bpmn:sequenceFlow id="f_gateOk_writeJoin" name="no" sourceRef="gateOk" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_gateOk_review" name="yes" sourceRef="gateOk" targetRef="review" />
    <bpmn:sequenceFlow id="f_review_findings" sourceRef="review" targetRef="findings" />
    <bpmn:sequenceFlow id="f_findings_writeJoin" name="some" sourceRef="findings" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_findings_read" name="none" sourceRef="findings" targetRef="read" />
    <bpmn:sequenceFlow id="f_read_clear" sourceRef="read" targetRef="clear" />
    <bpmn:sequenceFlow id="f_clear_writeJoin" name="no" sourceRef="clear" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_clear_end" name="yes" sourceRef="clear" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_model_gate_collab">
    <bpmndi:BPMNPlane id="BPMNPlane_model_gate_collab" bpmnElement="model_gate_collab">
