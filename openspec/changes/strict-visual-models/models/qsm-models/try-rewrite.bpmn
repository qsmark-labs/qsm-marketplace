          <dc:Bounds x="1286.7" y="656.5" width="76" height="56" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_keep" bpmnElement="keep" bioc:stroke="#094742" bioc:fill="#0f766e" color:border-color="#094742" color:background-color="#0f766e">
        <dc:Bounds x="1590.6000000000001" y="196" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_dropJoin" bpmnElement="dropJoin" bioc:stroke="#0f766e" bioc:fill="#ffffff" color:border-color="#0f766e" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="1615.6000000000001" y="419" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_drop" bpmnElement="drop" bioc:stroke="#094742" bioc:fill="#0f766e" color:border-color="#094742" color:background-color="#0f766e">
        <dc:Bounds x="1860.6000000000001" y="404" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
