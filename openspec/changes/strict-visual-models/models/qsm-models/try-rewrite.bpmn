      <bpmndi:BPMNShape id="BPMNShape_right" bpmnElement="right" bioc:stroke="#c2410c" bioc:fill="#ffffff" color:border-color="#c2410c" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="1379.3500000000001" y="731" width="50" height="50" />
