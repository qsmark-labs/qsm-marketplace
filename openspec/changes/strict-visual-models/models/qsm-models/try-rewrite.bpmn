      <bpmndi:BPMNShape id="BPMNShape_read" bpmnElement="read" bioc:stroke="#742707" bioc:fill="#c2410c" color:border-color="#742707" color:background-color="#c2410c">
        <dc:Bounds x="1118.1000000000001" y="716" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
