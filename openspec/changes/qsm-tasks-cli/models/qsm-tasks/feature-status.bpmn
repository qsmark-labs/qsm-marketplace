      <bpmndi:BPMNShape id="BPMNShape_endTestStays" bpmnElement="endTestStays" bioc:stroke="#4b5563" bioc:fill="#ffffff" color:border-color="#4b5563" color:background-color="#ffffff">
        <dc:Bounds x="1082.6" y="1681.8" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1071.775" y="1733.9" width="59" height="28" />
