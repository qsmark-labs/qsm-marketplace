      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endOther" bpmnElement="endOther" bioc:stroke="#4b5563" bioc:fill="#ffffff" color:border-color="#4b5563" color:background-color="#ffffff">
        <dc:Bounds x="846.35" y="189.4" width="36" height="36" />
