      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_testOpen_toBlocked" bpmnElement="f_testOpen_toBlocked">
        <di:waypoint x="686" y="1188" />
        <di:waypoint x="786" y="1188" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="724" y="1166" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_toBlocked_endBlocked" bpmnElement="f_toBlocked_endBlocked">
        <di:waypoint x="886" y="1188" />
