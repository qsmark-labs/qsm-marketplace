<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="cover_path_defs" targetNamespace="https://github.com/qsmark-labs/qsm-marketplace">
  <bpmn:collaboration id="cover_path_collab">
    <bpmn:participant id="cover_path_pool" name="Every cover path is proven by a scenario" processRef="cover_path_process" />
  </bpmn:collaboration>
  <bpmn:process id="cover_path_process" name="Every cover path is proven by a scenario" isExecutable="false">
    <bpmn:laneSet id="laneset">
      <bpmn:lane id="lane_0" name="Owner">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proven</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>asked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Agent">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>listJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tagged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process to prove">
      <bpmn:outgoing>f_start_listJoin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="listJoin">
      <bpmn:incoming>f_start_listJoin</bpmn:incoming>
      <bpmn:incoming>f_write_listJoin</bpmn:incoming>
      <bpmn:outgoing>f_listJoin_list</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="list" name="1 List the cover paths">
      <bpmn:incoming>f_listJoin_list</bpmn:incoming>
      <bpmn:outgoing>f_list_tagged</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="tagged" name="Every path tagged?">
      <bpmn:incoming>f_list_tagged</bpmn:incoming>
      <bpmn:outgoing>f_tagged_write</bpmn:outgoing>
      <bpmn:outgoing>f_tagged_run</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="write" name="2 Write a scenario for the path">
      <bpmn:incoming>f_tagged_write</bpmn:incoming>
      <bpmn:outgoing>f_write_listJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="run" name="3 Run the scenarios">
      <bpmn:incoming>f_tagged_run</bpmn:incoming>
      <bpmn:outgoing>f_run_store</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="store" name="4 Store the report">
      <bpmn:incoming>f_run_store</bpmn:incoming>
      <bpmn:outgoing>f_store_read</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="read" name="5 Read the paths on the process">
      <bpmn:incoming>f_store_read</bpmn:incoming>
      <bpmn:outgoing>f_read_passing</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="passing" name="Every path passing?">
      <bpmn:incoming>f_read_passing</bpmn:incoming>
      <bpmn:outgoing>f_passing_proven</bpmn:outgoing>
      <bpmn:outgoing>f_passing_ask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="proven" name="Process proven">
      <bpmn:incoming>f_passing_proven</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ask" name="6 Ask for a fix of the path">
      <bpmn:incoming>f_passing_ask</bpmn:incoming>
      <bpmn:outgoing>f_ask_asked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="asked" name="Fix asked">
      <bpmn:incoming>f_ask_asked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_listJoin" sourceRef="start" targetRef="listJoin" />
    <bpmn:sequenceFlow id="f_listJoin_list" sourceRef="listJoin" targetRef="list" />
    <bpmn:sequenceFlow id="f_list_tagged" sourceRef="list" targetRef="tagged" />
    <bpmn:sequenceFlow id="f_tagged_write" name="no" sourceRef="tagged" targetRef="write" />
    <bpmn:sequenceFlow id="f_write_listJoin" sourceRef="write" targetRef="listJoin" />
    <bpmn:sequenceFlow id="f_tagged_run" name="yes" sourceRef="tagged" targetRef="run" />
    <bpmn:sequenceFlow id="f_run_store" sourceRef="run" targetRef="store" />
    <bpmn:sequenceFlow id="f_store_read" sourceRef="store" targetRef="read" />
    <bpmn:sequenceFlow id="f_read_passing" sourceRef="read" targetRef="passing" />
    <bpmn:sequenceFlow id="f_passing_proven" name="yes" sourceRef="passing" targetRef="proven" />
    <bpmn:sequenceFlow id="f_passing_ask" name="no" sourceRef="passing" targetRef="ask" />
    <bpmn:sequenceFlow id="f_ask_asked" sourceRef="ask" targetRef="asked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_cover_path_collab">
    <bpmndi:BPMNPlane id="BPMNPlane_cover_path_collab" bpmnElement="cover_path_collab">
      <bpmndi:BPMNShape id="BPMNShape_cover_path_pool" bpmnElement="cover_path_pool" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="2338.2000000000003" height="1040" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_0" bpmnElement="lane_0" bioc:stroke="#08427b" bioc:fill="#c3d4e7" color:border-color="#08427b" color:background-color="#c3d4e7" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="2308.2000000000003" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_1" bpmnElement="lane_1" bioc:stroke="#6b4fbb" bioc:fill="#dcd3f2" color:border-color="#6b4fbb" color:background-color="#dcd3f2" isHorizontal="true">
        <dc:Bounds x="110" y="600" width="2308.2000000000003" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff">
        <dc:Bounds x="180.8" y="738" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="162.97500000000002" y="790.1" width="73" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_listJoin" bpmnElement="listJoin" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="366.85" y="731" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_list" bpmnElement="list" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="578.1" y="716" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_tagged" bpmnElement="tagged" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="839.35" y="731" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750.225" y="688.7" width="73" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_write" bpmnElement="write" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1050.6" y="924" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_run" bpmnElement="run" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1050.6" y="716" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_store" bpmnElement="store" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1320.6000000000001" y="716" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_read" bpmnElement="read" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="1590.6000000000001" y="196" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_passing" bpmnElement="passing" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="1851.8500000000001" y="211" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1762.7250000000001" y="168.7" width="73" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_proven" bpmnElement="proven" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff">
        <dc:Bounds x="2095.1000000000004" y="218" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2086.275" y="270.1" width="55" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ask" bpmnElement="ask" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="2063.1000000000004" y="404" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_asked" bpmnElement="asked" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff">
        <dc:Bounds x="2321.9" y="426" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2306.9" y="476" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_start_listJoin" bpmnElement="f_start_listJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="216.8" y="756" /><di:waypoint x="366.85" y="756" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_listJoin_list" bpmnElement="f_listJoin_list" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="416.85" y="756" /><di:waypoint x="578.1" y="756" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_list_tagged" bpmnElement="f_list_tagged" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="678.1" y="756" /><di:waypoint x="839.35" y="756" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_tagged_run" bpmnElement="f_tagged_run" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="889.35" y="756" /><di:waypoint x="1050.6" y="756" /><bpmndi:BPMNLabel><dc:Bounds x="953.7750000000001" y="729.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_run_store" bpmnElement="f_run_store" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1150.6" y="756" /><di:waypoint x="1320.6000000000001" y="756" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_store_read" bpmnElement="f_store_read" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1420.6000000000001" y="756" /><di:waypoint x="1640.6000000000001" y="756" /><di:waypoint x="1640.6000000000001" y="276" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_read_passing" bpmnElement="f_read_passing" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1690.6000000000001" y="236" /><di:waypoint x="1851.8500000000001" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_passing_proven" bpmnElement="f_passing_proven" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1901.8500000000001" y="236" /><di:waypoint x="2095.1000000000004" y="236" /><bpmndi:BPMNLabel><dc:Bounds x="1987.8750000000002" y="209.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_tagged_write" bpmnElement="f_tagged_write" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="864.35" y="781" /><di:waypoint x="864.35" y="964" /><di:waypoint x="1050.6" y="964" /><bpmndi:BPMNLabel><dc:Bounds x="875.6" y="869.9" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_passing_ask" bpmnElement="f_passing_ask" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1876.8500000000001" y="261" /><di:waypoint x="1876.8500000000001" y="444" /><di:waypoint x="2063.1000000000004" y="444" /><bpmndi:BPMNLabel><dc:Bounds x="1888.1000000000001" y="349.90000000000003" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_ask_asked" bpmnElement="f_ask_asked" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="2163.1000000000004" y="444" /><di:waypoint x="2321.9" y="444" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_write_listJoin" bpmnElement="f_write_listJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1073.6" y="1004" /><di:waypoint x="1073.6" y="1042" /><di:waypoint x="391.85" y="1042" /><di:waypoint x="391.85" y="781" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
