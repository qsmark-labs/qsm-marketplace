<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="build_task_defs" targetNamespace="https://github.com/qsmark-labs/qsm-marketplace">
  <bpmn:collaboration id="build_task_collab">
    <bpmn:participant id="build_task_pool" name="4-6 Build every open task" processRef="build_task_process" />
  </bpmn:collaboration>
  <bpmn:process id="build_task_process" name="4-6 Build every open task" isExecutable="false">
    <bpmn:laneSet id="laneset">
      <bpmn:lane id="lane_0" name="Agent">
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comments</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Review agent">
        <bpmn:flowNodeRef>reviewJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="Owner">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="GitHub">
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="open" name="Task open">
      <bpmn:outgoing>f_open_build</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="build" name="4 Build the task into a PR" calledElement="consume_task_process">
      <bpmn:incoming>f_open_build</bpmn:incoming>
      <bpmn:outgoing>f_build_reviewJoin</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="reviewJoin">
      <bpmn:incoming>f_build_reviewJoin</bpmn:incoming>
      <bpmn:incoming>f_fix_reviewJoin</bpmn:incoming>
      <bpmn:incoming>f_comments_reviewJoin</bpmn:incoming>
      <bpmn:outgoing>f_reviewJoin_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="review" name="5.1 Review the PR">
      <bpmn:incoming>f_reviewJoin_review</bpmn:incoming>
      <bpmn:outgoing>f_review_findings</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="findings" name="Findings?">
      <bpmn:incoming>f_review_findings</bpmn:incoming>
      <bpmn:outgoing>f_findings_fix</bpmn:outgoing>
      <bpmn:outgoing>f_findings_read</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="fix" name="5.2 Fix the findings">
      <bpmn:incoming>f_findings_fix</bpmn:incoming>
      <bpmn:outgoing>f_fix_reviewJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="read" name="6.1 Read the PR">
      <bpmn:incoming>f_findings_read</bpmn:incoming>
      <bpmn:outgoing>f_read_accepted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="accepted" name="PR accepted?">
      <bpmn:incoming>f_read_accepted</bpmn:incoming>
      <bpmn:outgoing>f_accepted_merge</bpmn:outgoing>
      <bpmn:outgoing>f_accepted_comments</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="comments" name="6.2 Fix the owner&#39;s comments">
      <bpmn:incoming>f_accepted_comments</bpmn:incoming>
      <bpmn:outgoing>f_comments_reviewJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="merge" name="6.3 Merge the PR into feature/&#60;n&#62;">
      <bpmn:incoming>f_accepted_merge</bpmn:incoming>
      <bpmn:outgoing>f_merge_close</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="close" name="6.4 Close the task the PR names">
      <bpmn:incoming>f_merge_close</bpmn:incoming>
      <bpmn:outgoing>f_close_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="done" name="Task closed">
      <bpmn:incoming>f_close_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_open_build" sourceRef="open" targetRef="build" />
    <bpmn:sequenceFlow id="f_build_reviewJoin" sourceRef="build" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_reviewJoin_review" sourceRef="reviewJoin" targetRef="review" />
    <bpmn:sequenceFlow id="f_review_findings" sourceRef="review" targetRef="findings" />
    <bpmn:sequenceFlow id="f_findings_fix" name="some" sourceRef="findings" targetRef="fix" />
    <bpmn:sequenceFlow id="f_fix_reviewJoin" sourceRef="fix" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_findings_read" name="none" sourceRef="findings" targetRef="read" />
    <bpmn:sequenceFlow id="f_read_accepted" sourceRef="read" targetRef="accepted" />
    <bpmn:sequenceFlow id="f_accepted_merge" name="yes" sourceRef="accepted" targetRef="merge" />
    <bpmn:sequenceFlow id="f_accepted_comments" name="no" sourceRef="accepted" targetRef="comments" />
    <bpmn:sequenceFlow id="f_comments_reviewJoin" sourceRef="comments" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_merge_close" sourceRef="merge" targetRef="close" />
    <bpmn:sequenceFlow id="f_close_done" sourceRef="close" targetRef="done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_build_task_collab">
    <bpmndi:BPMNPlane id="BPMNPlane_build_task_collab" bpmnElement="build_task_collab">
      <bpmndi:BPMNShape id="BPMNShape_build_task_pool" bpmnElement="build_task_pool" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="2338.2000000000003" height="1456" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_0" bpmnElement="lane_0" bioc:stroke="#6b4fbb" bioc:fill="#dcd3f2" color:border-color="#6b4fbb" color:background-color="#dcd3f2" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="2308.2000000000003" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_1" bpmnElement="lane_1" bioc:stroke="#c2410c" bioc:fill="#f4d2c1" color:border-color="#c2410c" color:background-color="#f4d2c1" isHorizontal="true">
        <dc:Bounds x="110" y="600" width="2308.2000000000003" height="312" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_2" bpmnElement="lane_2" bioc:stroke="#08427b" bioc:fill="#c3d4e7" color:border-color="#08427b" color:background-color="#c3d4e7" isHorizontal="true">
        <dc:Bounds x="110" y="912" width="2308.2000000000003" height="312" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_3" bpmnElement="lane_3" bioc:stroke="#4b5563" bioc:fill="#d4d7dc" color:border-color="#4b5563" color:background-color="#d4d7dc" isHorizontal="true">
        <dc:Bounds x="110" y="1224" width="2308.2000000000003" height="312" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_open" bpmnElement="open" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff">
        <dc:Bounds x="180.8" y="218" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="165.8" y="268" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_build" bpmnElement="build" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="375.6" y="196" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_reviewJoin" bpmnElement="reviewJoin" bioc:stroke="#c2410c" bioc:fill="#ffffff" color:border-color="#c2410c" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="636.85" y="731" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_review" bpmnElement="review" bioc:stroke="#742707" bioc:fill="#c2410c" color:border-color="#742707" color:background-color="#c2410c">
        <dc:Bounds x="848.1" y="716" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_findings" bpmnElement="findings" bioc:stroke="#c2410c" bioc:fill="#ffffff" color:border-color="#c2410c" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="1109.3500000000001" y="731" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1024.9250000000002" y="704.8000000000001" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_fix" bpmnElement="fix" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1320.6000000000001" y="404" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_read" bpmnElement="read" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="1320.6000000000001" y="1028" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_accepted" bpmnElement="accepted" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="1581.8500000000001" y="1043" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1473.9250000000002" y="1016.8000000000001" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_comments" bpmnElement="comments" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1793.1000000000001" y="404" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_merge" bpmnElement="merge" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="1793.1000000000001" y="1028" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_close" bpmnElement="close" bioc:stroke="#2d333b" bioc:fill="#4b5563" color:border-color="#2d333b" color:background-color="#4b5563">
        <dc:Bounds x="2063.1000000000004" y="1340" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_done" bpmnElement="done" bioc:stroke="#4b5563" bioc:fill="#ffffff" color:border-color="#4b5563" color:background-color="#ffffff">
        <dc:Bounds x="2321.9" y="1362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2299.9" y="1412" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_open_build" bpmnElement="f_open_build" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="216.8" y="236" /><di:waypoint x="375.6" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_build_reviewJoin" bpmnElement="f_build_reviewJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="475.6" y="236" /><di:waypoint x="661.85" y="236" /><di:waypoint x="661.85" y="731" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_reviewJoin_review" bpmnElement="f_reviewJoin_review" bioc:stroke="#c2410c" color:border-color="#c2410c"><di:waypoint x="686.85" y="756" /><di:waypoint x="848.1" y="756" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_review_findings" bpmnElement="f_review_findings" bioc:stroke="#c2410c" color:border-color="#c2410c"><di:waypoint x="948.1" y="756" /><di:waypoint x="1109.3500000000001" y="756" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_findings_read" bpmnElement="f_findings_read" bioc:stroke="#c2410c" color:border-color="#c2410c"><di:waypoint x="1159.3500000000001" y="756" /><di:waypoint x="1370.6000000000001" y="756" /><di:waypoint x="1370.6000000000001" y="1028" /><bpmndi:BPMNLabel><dc:Bounds x="1253.3500000000001" y="729.5" width="32" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_read_accepted" bpmnElement="f_read_accepted" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1420.6000000000001" y="1068" /><di:waypoint x="1581.8500000000001" y="1068" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_accepted_merge" bpmnElement="f_accepted_merge" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1631.8500000000001" y="1068" /><di:waypoint x="1793.1000000000001" y="1068" /><bpmndi:BPMNLabel><dc:Bounds x="1696.275" y="1041.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_merge_close" bpmnElement="f_merge_close" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1893.1000000000001" y="1068" /><di:waypoint x="2113.1000000000004" y="1068" /><di:waypoint x="2113.1000000000004" y="1340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_close_done" bpmnElement="f_close_done" bioc:stroke="#4b5563" color:border-color="#4b5563"><di:waypoint x="2163.1000000000004" y="1380" /><di:waypoint x="2321.9" y="1380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_findings_fix" bpmnElement="f_findings_fix" bioc:stroke="#c2410c" color:border-color="#c2410c"><di:waypoint x="1134.3500000000001" y="731" /><di:waypoint x="1134.3500000000001" y="444" /><di:waypoint x="1320.6000000000001" y="444" /><bpmndi:BPMNLabel><dc:Bounds x="1147.2250000000001" y="577.4000000000001" width="35" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_accepted_comments" bpmnElement="f_accepted_comments" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1606.8500000000001" y="1043" /><di:waypoint x="1606.8500000000001" y="444" /><di:waypoint x="1793.1000000000001" y="444" /><bpmndi:BPMNLabel><dc:Bounds x="1618.1000000000001" y="733.4" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_fix_reviewJoin" bpmnElement="f_fix_reviewJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1343.6000000000001" y="484" /><di:waypoint x="1343.6000000000001" y="814.5" /><di:waypoint x="661.85" y="814.5" /><di:waypoint x="661.85" y="781" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_comments_reviewJoin" bpmnElement="f_comments_reviewJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1816.1000000000001" y="484" /><di:waypoint x="1816.1000000000001" y="814.5" /><di:waypoint x="661.85" y="814.5" /><di:waypoint x="661.85" y="781" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
