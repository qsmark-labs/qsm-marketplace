// C4 levels 1 and 2 of the marketplace, for the feature flow.
// Every element name is the lane name a BPMN process uses for the same actor. Relations between
// containers are the plugin dependencies after this feature and the ones it waits on.
model {
  owner = person 'Owner' 'Writes features, approves plans, merges PRs, accepts features' {
    metadata { colour 'navy' }
  }

  agent = system 'Agent' 'A Claude Code session that plans, splits and builds' {
    #agent
    metadata { colour 'purple' }
  }
  reviewer = system 'Review agent' 'A Claude Code session that reviews a PR and posts findings' {
    #agent
    metadata { colour 'orange' }
  }
  qa = system 'QA agent' 'A Claude Code session that tests a feature branch in a sandbox' {
    #agent
    metadata { colour 'green' }
  }

  github = system 'GitHub' 'Issues, the board, pull requests and Actions of the repository' {
    #external
  }
  openspec = system 'OpenSpec CLI' 'Validates changes and their artifacts' {
    #external
  }

  mp = system 'qsm-marketplace' 'Plugins installed into Claude Code' {
    tasks = container 'qsm-tasks' 'One door to the board: features, tasks, feedback' {
      technology 'Bun binary'
      metadata { group 'Board and pull requests' path 'plugins/qsm-tasks' }
    }
    plan = container 'qsm-plan' 'Sizes an ask, grills a feature, splits it into tasks' {
      technology 'Skills'
      metadata { group 'Plan and specify' path 'plugins/qsm-plan' }
    }
    spec = container 'qsm-openspec' 'The feature schema and the skills that write and consume a change' {
      technology 'Skills'
      metadata { group 'Plan and specify' path 'plugins/qsm-openspec' }
    }
    models = container 'qsm-models' 'Lints, renders and walks BPMN and C4 models' {
      technology 'Bun binary'
      metadata { group 'Plan and specify' path 'plugins/qsm-models' }
    }
    review = container 'qsm-review' 'Reviews a PR and posts the findings' {
      technology 'Skills and agents'
      metadata { group 'Review and see' path 'plugins/qsm-review' }
    }
    forge = container 'qsm-forge' 'Opens PRs, reads and resolves review threads' {
      technology 'Bun binary'
      metadata { group 'Board and pull requests' path 'plugins/qsm-forge' }
    }
    memory = container 'qsm-memory' 'Earlier sessions, searched by full text' {
      technology 'Bun binary'
      metadata { group 'Context' path 'plugins/qsm-memory' }
    }
    index = container 'qsm-index' 'The code index: search, structure, impact' {
      technology 'Bun binary'
      metadata { group 'Context' path 'plugins/qsm-index' }
    }
    essentials = container 'qsm-essentials' 'The core: worker agents and the skills every session loads' {
      #shared
      technology 'Skills and agents'
      metadata { group 'Context' path 'plugins/qsm-essentials' }
    }
    lens = container 'qsm-builder lens' 'A static page of every plugin, its spec and its models' {
      technology 'Bun binary'
      metadata { group 'Review and see' path 'plugins/qsm-builder' }
    }
  }

  owner -> github 'files features, merges PRs'
  owner -> mp.lens 'reads the models'
  owner -> agent 'plans and splits with'

  agent -> mp.plan 'plans and splits with'
  agent -> mp.spec 'writes the change with'
  agent -> mp.models 'lints and renders models with'
  agent -> mp.tasks 'creates and claims tasks with'
  agent -> mp.memory 'gathers context from'
  agent -> mp.index 'gathers context from'
  agent -> mp.forge 'opens PRs with'

  reviewer -> mp.review 'reviews with'
  reviewer -> mp.forge 'posts findings with'

  qa -> mp.models 'reads the cover paths from'
  qa -> mp.tasks 'files fix tasks with'

  qa -> mp.review 'runs as an agent of'

  mp.plan -> mp.tasks 'files and splits features with'
  mp.plan -> mp.spec 'hands the change to'
  mp.spec -> mp.essentials 'hands disjoint work to the agents of'
  mp.spec -> mp.tasks 'binds the change to its feature with'
  mp.spec -> mp.models 'lints, renders and walks models with'
  mp.spec -> mp.forge 'opens the task PR with'
  mp.review -> mp.forge 'posts reviews with'
  mp.review -> mp.models 'reads the cover paths with'
  mp.lens -> mp.tasks 'saves a pen edit with'
  mp.lens -> mp.spec 'reads the changes with'

  mp.tasks -> github 'reads and writes issues and the board'
  mp.forge -> github 'opens PRs, reads threads'
  mp.spec -> openspec 'validates changes with'
}
