        <dc:Bounds x="2686" y="1455" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2677" y="1436" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_conflictTask" bpmnElement="conflictTask">
        <dc:Bounds x="2836" y="1600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ready" bpmnElement="ready">
        <dc:Bounds x="2836" y="1440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_qa" bpmnElement="qa">
        <dc:Bounds x="3036" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_qaOk" bpmnElement="qaOk" isMarkerVisible="true">
        <dc:Bounds x="3236" y="1055" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3220" y="1036" width="82" height="14" />
        </bpmndi:BPMNLabel>
