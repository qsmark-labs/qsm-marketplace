<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="feature_flow_defs" targetNamespace="https://github.com/qsmark-labs/qsm-marketplace">
  <bpmn:collaboration id="feature_flow_collab">
    <bpmn:participant id="feature_flow_pool" name="A feature from request to main" processRef="feature_flow_process" />
  </bpmn:collaboration>
  <bpmn:process id="feature_flow_process" name="A feature from request to main" isExecutable="false">
    <bpmn:laneSet id="laneset">
      <bpmn:lane id="lane_0" name="Owner">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Agent">
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nextTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>featurePr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="Review agent">
        <bpmn:flowNodeRef>reviewJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="QA agent">
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qaOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fileFix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_4" name="GitHub">
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Business need">
      <bpmn:outgoing>f_need_request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="request" name="1 File the feature request">
      <bpmn:incoming>f_need_request</bpmn:incoming>
      <bpmn:outgoing>f_request_planJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="plan" name="2 Plan: intent, models, specs">
      <bpmn:incoming>f_planJoin_plan</bpmn:incoming>
      <bpmn:outgoing>f_plan_planOk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="planOk" name="Plan approved?">
      <bpmn:incoming>f_plan_planOk</bpmn:incoming>
      <bpmn:outgoing>f_planOk_split</bpmn:outgoing>
      <bpmn:outgoing>f_planOk_planJoin</bpmn:outgoing>
      <bpmn:outgoing>f_planOk_dropped</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="dropped" name="Closed as not planned">
      <bpmn:incoming>f_planOk_dropped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="split" name="3 Split into tasks on feature/&#60;n&#62;">
      <bpmn:incoming>f_planOk_split</bpmn:incoming>
      <bpmn:outgoing>f_split_nextTask</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="nextTask" name="Task to build">
      <bpmn:incoming>f_split_nextTask</bpmn:incoming>
      <bpmn:incoming>f_open_nextTask</bpmn:incoming>
      <bpmn:incoming>f_fileFix_nextTask</bpmn:incoming>
      <bpmn:incoming>f_reject_nextTask</bpmn:incoming>
      <bpmn:outgoing>f_nextTask_consume</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="planJoin" name="Plan or revise">
      <bpmn:incoming>f_request_planJoin</bpmn:incoming>
      <bpmn:incoming>f_planOk_planJoin</bpmn:incoming>
      <bpmn:outgoing>f_planJoin_plan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="reviewJoin" name="PR to review">
      <bpmn:incoming>f_consume_reviewJoin</bpmn:incoming>
      <bpmn:incoming>f_fix_reviewJoin</bpmn:incoming>
      <bpmn:incoming>f_resolve_reviewJoin</bpmn:incoming>
      <bpmn:outgoing>f_reviewJoin_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="fixJoin" name="Something to fix">
      <bpmn:incoming>f_findings_fixJoin</bpmn:incoming>
      <bpmn:incoming>f_prOk_fixJoin</bpmn:incoming>
      <bpmn:outgoing>f_fixJoin_fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="consume" name="4 Build one task, open its PR">
      <bpmn:incoming>f_nextTask_consume</bpmn:incoming>
      <bpmn:outgoing>f_consume_reviewJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="review" name="5 Review the PR">
      <bpmn:incoming>f_reviewJoin_review</bpmn:incoming>
      <bpmn:outgoing>f_review_findings</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="findings" name="Findings?">
      <bpmn:incoming>f_review_findings</bpmn:incoming>
      <bpmn:outgoing>f_findings_fixJoin</bpmn:outgoing>
      <bpmn:outgoing>f_findings_read</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="fix" name="Fix the findings">
      <bpmn:incoming>f_fixJoin_fix</bpmn:incoming>
      <bpmn:outgoing>f_fix_reviewJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="read" name="6 Read the PR">
      <bpmn:incoming>f_findings_read</bpmn:incoming>
      <bpmn:outgoing>f_read_prOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="prOk" name="Merge it?">
      <bpmn:incoming>f_read_prOk</bpmn:incoming>
      <bpmn:outgoing>f_prOk_close</bpmn:outgoing>
      <bpmn:outgoing>f_prOk_fixJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="close" name="Close the tasks the PR names">
      <bpmn:incoming>f_prOk_close</bpmn:incoming>
      <bpmn:outgoing>f_close_open</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="open" name="Tasks still open?">
      <bpmn:incoming>f_close_open</bpmn:incoming>
      <bpmn:outgoing>f_open_nextTask</bpmn:outgoing>
      <bpmn:outgoing>f_open_sync</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="sync" name="7 Bring feature/&#60;n&#62; up to date with main">
      <bpmn:incoming>f_open_sync</bpmn:incoming>
      <bpmn:outgoing>f_sync_conflict</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="conflict" name="Conflict?">
      <bpmn:incoming>f_sync_conflict</bpmn:incoming>
      <bpmn:outgoing>f_conflict_resolve</bpmn:outgoing>
      <bpmn:outgoing>f_conflict_qa</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="resolve" name="Resolve the conflict in a PR">
      <bpmn:incoming>f_conflict_resolve</bpmn:incoming>
      <bpmn:outgoing>f_resolve_reviewJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="qa" name="8 Deploy to a sandbox, test every path">
      <bpmn:incoming>f_conflict_qa</bpmn:incoming>
      <bpmn:outgoing>f_qa_qaOk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="qaOk" name="QA finding?">
      <bpmn:incoming>f_qa_qaOk</bpmn:incoming>
      <bpmn:outgoing>f_qaOk_fileFix</bpmn:outgoing>
      <bpmn:outgoing>f_qaOk_featurePr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="fileFix" name="File a fix task under the feature">
      <bpmn:incoming>f_qaOk_fileFix</bpmn:incoming>
      <bpmn:outgoing>f_fileFix_nextTask</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="featurePr" name="9 Open the feature PR to main">
      <bpmn:incoming>f_qaOk_featurePr</bpmn:incoming>
      <bpmn:outgoing>f_featurePr_accept</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="accept" name="Read the feature PR">
      <bpmn:incoming>f_featurePr_accept</bpmn:incoming>
      <bpmn:outgoing>f_accept_acceptOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="acceptOk" name="Accept?">
      <bpmn:incoming>f_accept_acceptOk</bpmn:incoming>
      <bpmn:outgoing>f_acceptOk_merge</bpmn:outgoing>
      <bpmn:outgoing>f_acceptOk_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reject" name="File the rejection as a fix task">
      <bpmn:incoming>f_acceptOk_reject</bpmn:incoming>
      <bpmn:outgoing>f_reject_nextTask</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="merge" name="Merge the feature PR into main">
      <bpmn:incoming>f_acceptOk_merge</bpmn:incoming>
      <bpmn:outgoing>f_merge_done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="done" name="Feature done">
      <bpmn:incoming>f_merge_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_need_request" sourceRef="need" targetRef="request" />
    <bpmn:sequenceFlow id="f_request_planJoin" sourceRef="request" targetRef="planJoin" />
    <bpmn:sequenceFlow id="f_planJoin_plan" sourceRef="planJoin" targetRef="plan" />
    <bpmn:sequenceFlow id="f_plan_planOk" sourceRef="plan" targetRef="planOk" />
    <bpmn:sequenceFlow id="f_planOk_split" name="yes" sourceRef="planOk" targetRef="split" />
    <bpmn:sequenceFlow id="f_planOk_planJoin" name="revise" sourceRef="planOk" targetRef="planJoin" />
    <bpmn:sequenceFlow id="f_planOk_dropped" name="drop" sourceRef="planOk" targetRef="dropped" />
    <bpmn:sequenceFlow id="f_split_nextTask" sourceRef="split" targetRef="nextTask" />
    <bpmn:sequenceFlow id="f_nextTask_consume" sourceRef="nextTask" targetRef="consume" />
    <bpmn:sequenceFlow id="f_consume_reviewJoin" sourceRef="consume" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_reviewJoin_review" sourceRef="reviewJoin" targetRef="review" />
    <bpmn:sequenceFlow id="f_review_findings" sourceRef="review" targetRef="findings" />
    <bpmn:sequenceFlow id="f_findings_fixJoin" name="yes" sourceRef="findings" targetRef="fixJoin" />
    <bpmn:sequenceFlow id="f_findings_read" name="none" sourceRef="findings" targetRef="read" />
    <bpmn:sequenceFlow id="f_fixJoin_fix" sourceRef="fixJoin" targetRef="fix" />
    <bpmn:sequenceFlow id="f_fix_reviewJoin" sourceRef="fix" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_read_prOk" sourceRef="read" targetRef="prOk" />
    <bpmn:sequenceFlow id="f_prOk_close" name="merge" sourceRef="prOk" targetRef="close" />
    <bpmn:sequenceFlow id="f_prOk_fixJoin" name="changes requested" sourceRef="prOk" targetRef="fixJoin" />
    <bpmn:sequenceFlow id="f_close_open" sourceRef="close" targetRef="open" />
    <bpmn:sequenceFlow id="f_open_nextTask" name="yes" sourceRef="open" targetRef="nextTask" />
    <bpmn:sequenceFlow id="f_open_sync" name="no" sourceRef="open" targetRef="sync" />
    <bpmn:sequenceFlow id="f_sync_conflict" sourceRef="sync" targetRef="conflict" />
    <bpmn:sequenceFlow id="f_conflict_resolve" name="yes" sourceRef="conflict" targetRef="resolve" />
    <bpmn:sequenceFlow id="f_conflict_qa" name="no" sourceRef="conflict" targetRef="qa" />
    <bpmn:sequenceFlow id="f_resolve_reviewJoin" sourceRef="resolve" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_qa_qaOk" sourceRef="qa" targetRef="qaOk" />
    <bpmn:sequenceFlow id="f_qaOk_fileFix" name="yes" sourceRef="qaOk" targetRef="fileFix" />
    <bpmn:sequenceFlow id="f_qaOk_featurePr" name="no" sourceRef="qaOk" targetRef="featurePr" />
    <bpmn:sequenceFlow id="f_fileFix_nextTask" sourceRef="fileFix" targetRef="nextTask" />
    <bpmn:sequenceFlow id="f_featurePr_accept" sourceRef="featurePr" targetRef="accept" />
    <bpmn:sequenceFlow id="f_accept_acceptOk" sourceRef="accept" targetRef="acceptOk" />
    <bpmn:sequenceFlow id="f_acceptOk_merge" name="yes" sourceRef="acceptOk" targetRef="merge" />
    <bpmn:sequenceFlow id="f_acceptOk_reject" name="no" sourceRef="acceptOk" targetRef="reject" />
    <bpmn:sequenceFlow id="f_reject_nextTask" sourceRef="reject" targetRef="nextTask" />
    <bpmn:sequenceFlow id="f_merge_done" sourceRef="merge" targetRef="done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_feature_flow_collab">
    <bpmndi:BPMNPlane id="BPMNPlane_feature_flow_collab" bpmnElement="feature_flow_collab">
      <bpmndi:BPMNShape id="BPMNShape_feature_flow_pool" bpmnElement="feature_flow_pool" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="4232" height="1680" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_0" bpmnElement="lane_0" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="4202" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_1" bpmnElement="lane_1" isHorizontal="true">
        <dc:Bounds x="110" y="480" width="4202" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_2" bpmnElement="lane_2" isHorizontal="true">
        <dc:Bounds x="110" y="880" width="4202" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_3" bpmnElement="lane_3" isHorizontal="true">
        <dc:Bounds x="110" y="1120" width="4202" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_4" bpmnElement="lane_4" isHorizontal="true">
        <dc:Bounds x="110" y="1520" width="4202" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_need" bpmnElement="need">
        <dc:Bounds x="150" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="137" y="223" width="62" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
