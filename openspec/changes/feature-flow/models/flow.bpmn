        <bpmndi:BPMNLabel>
          <dc:Bounds x="4161" y="1503" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_need_request" bpmnElement="f_need_request">
        <di:waypoint x="186" y="200" />
        <di:waypoint x="286" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_request_plan" bpmnElement="f_request_plan">
        <di:waypoint x="386" y="200" />
        <di:waypoint x="536" y="200" />
        <di:waypoint x="536" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_plan_planMerge" bpmnElement="f_plan_planMerge">
        <di:waypoint x="586" y="440" />
        <di:waypoint x="736" y="440" />
        <di:waypoint x="736" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_planMerge_split" bpmnElement="f_planMerge_split">
        <di:waypoint x="786" y="200" />
        <di:waypoint x="936" y="200" />
        <di:waypoint x="936" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_split_nextTask" bpmnElement="f_split_nextTask">
        <di:waypoint x="986" y="440" />
        <di:waypoint x="1086" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_nextTask_consume" bpmnElement="f_nextTask_consume">
        <di:waypoint x="1136" y="440" />
        <di:waypoint x="1236" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_consume_reviewJoin" bpmnElement="f_consume_reviewJoin">
        <di:waypoint x="1336" y="440" />
        <di:waypoint x="1461" y="440" />
        <di:waypoint x="1461" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_reviewJoin_review" bpmnElement="f_reviewJoin_review">
        <di:waypoint x="1486" y="840" />
        <di:waypoint x="1586" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_review_findings" bpmnElement="f_review_findings">
        <di:waypoint x="1686" y="840" />
        <di:waypoint x="1786" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_findings_merge" bpmnElement="f_findings_merge">
        <di:waypoint x="1811" y="815" />
        <di:waypoint x="1811" y="200" />
        <di:waypoint x="1936" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1816" y="393" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_merge_close" bpmnElement="f_merge_close">
        <di:waypoint x="2036" y="200" />
        <di:waypoint x="2186" y="200" />
        <di:waypoint x="2186" y="1440" />
