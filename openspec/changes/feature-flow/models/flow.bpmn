          <dc:Bounds x="828" y="142" width="67" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_dropped" bpmnElement="dropped">
        <dc:Bounds x="1018" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="997" y="383" width="78" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_split" bpmnElement="split">
        <dc:Bounds x="986" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_nextTask" bpmnElement="nextTask" isMarkerVisible="true">
        <dc:Bounds x="1186" y="575" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1185" y="542" width="52" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_planJoin" bpmnElement="planJoin" isMarkerVisible="true">
        <dc:Bounds x="486" y="575" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="429" y="586" width="52" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_reviewJoin" bpmnElement="reviewJoin" isMarkerVisible="true">
        <dc:Bounds x="1536" y="975" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1442" y="993" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_fixJoin" bpmnElement="fixJoin" isMarkerVisible="true">
        <dc:Bounds x="2411" y="735" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2391" y="790" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_consume" bpmnElement="consume">
        <dc:Bounds x="1336" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_review" bpmnElement="review">
        <dc:Bounds x="1686" y="960" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_findings" bpmnElement="findings" isMarkerVisible="true">
        <dc:Bounds x="1886" y="975" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1877" y="1050" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_fix" bpmnElement="fix">
        <dc:Bounds x="2586" y="720" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_read" bpmnElement="read">
        <dc:Bounds x="2036" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_prOk" bpmnElement="prOk" isMarkerVisible="true">
        <dc:Bounds x="2236" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2291" y="193" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_close" bpmnElement="close">
        <dc:Bounds x="2386" y="1600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_open" bpmnElement="open" isMarkerVisible="true">
        <dc:Bounds x="2611" y="1615" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2596" y="1582" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_sync" bpmnElement="sync">
        <dc:Bounds x="2786" y="1600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_conflict" bpmnElement="conflict" isMarkerVisible="true">
        <dc:Bounds x="2986" y="1615" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2977" y="1670" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_resolve" bpmnElement="resolve">
        <dc:Bounds x="3136" y="720" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_qa" bpmnElement="qa">
        <dc:Bounds x="3136" y="1200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_qaOk" bpmnElement="qaOk" isMarkerVisible="true">
        <dc:Bounds x="3336" y="1215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3320" y="1196" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_fileFix" bpmnElement="fileFix">
        <dc:Bounds x="3486" y="1360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_featurePr" bpmnElement="featurePr">
        <dc:Bounds x="3486" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_accept" bpmnElement="accept">
        <dc:Bounds x="3686" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_acceptOk" bpmnElement="acceptOk" isMarkerVisible="true">
        <dc:Bounds x="3886" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3884" y="156" width="55" height="14" />
