      <bpmndi:BPMNEdge id="BPMNEdge_f_conflictTask_buildJoin" bpmnElement="f_conflictTask_buildJoin" bioc:stroke="#4b5563" color:border-color="#4b5563">
        <di:waypoint x="1766" y="996" />
        <di:waypoint x="1766" y="1016" />
