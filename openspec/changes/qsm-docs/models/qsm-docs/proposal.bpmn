<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="docs_proposal_defs" targetNamespace="https://github.com/qsmark-labs/qsm-marketplace">
  <bpmn:collaboration id="docs_proposal_collab">
    <bpmn:participant id="docs_proposal_pool" name="An edit on a page becomes a proposal" processRef="docs_proposal_process" />
  </bpmn:collaboration>
  <bpmn:process id="docs_proposal_process" name="An edit on a page becomes a proposal" isExecutable="false">
    <bpmn:laneSet id="laneset">
      <bpmn:lane id="lane_0" name="Owner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Agent">
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>say</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Document to change">
      <bpmn:outgoing>f_start_open</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="open" name="1 Open the page of the document">
      <bpmn:incoming>f_start_open</bpmn:incoming>
      <bpmn:outgoing>f_open_edit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="edit" name="2 Edit the document in edit mode">
      <bpmn:incoming>f_open_edit</bpmn:incoming>
      <bpmn:outgoing>f_edit_save</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="save" name="3 Save the edit as a proposal">
      <bpmn:incoming>f_edit_save</bpmn:incoming>
      <bpmn:outgoing>f_save_tell</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="tell" name="4 Name the proposal in the next prompt">
      <bpmn:incoming>f_save_tell</bpmn:incoming>
      <bpmn:outgoing>f_tell_read</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="read" name="5 Read the proposal and its diff">
      <bpmn:incoming>f_tell_read</bpmn:incoming>
      <bpmn:outgoing>f_read_clean</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="clean" name="Applies cleanly?">
      <bpmn:incoming>f_read_clean</bpmn:incoming>
      <bpmn:outgoing>f_clean_apply</bpmn:outgoing>
      <bpmn:outgoing>f_clean_say</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="apply" name="6 Create the applied snapshot">
      <bpmn:incoming>f_clean_apply</bpmn:incoming>
      <bpmn:outgoing>f_apply_applied</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="applied" name="Proposal applied">
      <bpmn:incoming>f_apply_applied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="say" name="7 Tell the owner what blocks it">
      <bpmn:incoming>f_clean_say</bpmn:incoming>
      <bpmn:outgoing>f_say_open_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="open_end" name="Proposal still open">
      <bpmn:incoming>f_say_open_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_open" sourceRef="start" targetRef="open" />
    <bpmn:sequenceFlow id="f_open_edit" sourceRef="open" targetRef="edit" />
    <bpmn:sequenceFlow id="f_edit_save" sourceRef="edit" targetRef="save" />
    <bpmn:sequenceFlow id="f_save_tell" sourceRef="save" targetRef="tell" />
    <bpmn:sequenceFlow id="f_tell_read" sourceRef="tell" targetRef="read" />
    <bpmn:sequenceFlow id="f_read_clean" sourceRef="read" targetRef="clean" />
    <bpmn:sequenceFlow id="f_clean_apply" name="yes" sourceRef="clean" targetRef="apply" />
    <bpmn:sequenceFlow id="f_clean_say" name="no" sourceRef="clean" targetRef="say" />
    <bpmn:sequenceFlow id="f_apply_applied" sourceRef="apply" targetRef="applied" />
    <bpmn:sequenceFlow id="f_say_open_end" sourceRef="say" targetRef="open_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_docs_proposal_collab">
    <bpmndi:BPMNPlane id="BPMNPlane_docs_proposal_collab" bpmnElement="docs_proposal_collab">
      <bpmndi:BPMNShape id="BPMNShape_docs_proposal_pool" bpmnElement="docs_proposal_pool" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="2203.2000000000003" height="832" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_0" bpmnElement="lane_0" bioc:stroke="#08427b" bioc:fill="#c3d4e7" color:border-color="#08427b" color:background-color="#c3d4e7" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="2173.2000000000003" height="312" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_1" bpmnElement="lane_1" bioc:stroke="#6b4fbb" bioc:fill="#dcd3f2" color:border-color="#6b4fbb" color:background-color="#dcd3f2" isHorizontal="true">
        <dc:Bounds x="110" y="392" width="2173.2000000000003" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff">
        <dc:Bounds x="180.8" y="218" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157.97500000000002" y="270.1" width="83" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_open" bpmnElement="open" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="375.6" y="196" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_edit" bpmnElement="edit" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="645.6" y="196" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_save" bpmnElement="save" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="915.6" y="196" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_tell" bpmnElement="tell" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1185.6000000000001" y="508" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_read" bpmnElement="read" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1455.6000000000001" y="508" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_clean" bpmnElement="clean" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="1716.8500000000001" y="523" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1643" y="480.7" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_apply" bpmnElement="apply" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1928.1000000000001" y="508" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_applied" bpmnElement="applied" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff">
        <dc:Bounds x="2186.9" y="530" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2173.9" y="582.1" width="62" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_say" bpmnElement="say" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="1928.1000000000001" y="716" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_open_end" bpmnElement="open_end" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff">
        <dc:Bounds x="2186.9" y="738" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2170.0750000000003" y="790.1" width="71" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_start_open" bpmnElement="f_start_open" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="216.8" y="236" /><di:waypoint x="375.6" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_open_edit" bpmnElement="f_open_edit" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="475.6" y="236" /><di:waypoint x="645.6" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_edit_save" bpmnElement="f_edit_save" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="745.6" y="236" /><di:waypoint x="915.6" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_save_tell" bpmnElement="f_save_tell" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1015.6" y="236" /><di:waypoint x="1235.6000000000001" y="236" /><di:waypoint x="1235.6000000000001" y="508" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_tell_read" bpmnElement="f_tell_read" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1285.6000000000001" y="548" /><di:waypoint x="1455.6000000000001" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_read_clean" bpmnElement="f_read_clean" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1555.6000000000001" y="548" /><di:waypoint x="1716.8500000000001" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_clean_apply" bpmnElement="f_clean_apply" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1766.8500000000001" y="548" /><di:waypoint x="1928.1000000000001" y="548" /><bpmndi:BPMNLabel><dc:Bounds x="1831.275" y="521.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_apply_applied" bpmnElement="f_apply_applied" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="2028.1000000000001" y="548" /><di:waypoint x="2186.9" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_clean_say" bpmnElement="f_clean_say" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1741.8500000000001" y="573" /><di:waypoint x="1741.8500000000001" y="756" /><di:waypoint x="1928.1000000000001" y="756" /><bpmndi:BPMNLabel><dc:Bounds x="1753.1000000000001" y="661.9" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_say_open_end" bpmnElement="f_say_open_end" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="2028.1000000000001" y="756" /><di:waypoint x="2186.9" y="756" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
