<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="docs_delete_defs" targetNamespace="https://github.com/qsmark-labs/qsm-marketplace">
  <bpmn:collaboration id="docs_delete_collab">
    <bpmn:participant id="docs_delete_pool" name="A snapshot is deleted by the owner only" processRef="docs_delete_process" />
  </bpmn:collaboration>
  <bpmn:process id="docs_delete_process" name="A snapshot is deleted by the owner only" isExecutable="false">
    <bpmn:laneSet id="laneset">
      <bpmn:lane id="lane_0" name="Owner">
        <bpmn:flowNodeRef>want</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Agent">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="A snapshot looks unwanted">
      <bpmn:outgoing>f_start_run</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="run" name="1 Run qsm-docs delete">
      <bpmn:incoming>f_start_run</bpmn:incoming>
      <bpmn:outgoing>f_run_deny</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deny" name="2 Deny the call">
      <bpmn:incoming>f_run_deny</bpmn:incoming>
      <bpmn:outgoing>f_deny_ask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="ask" name="3 Ask the owner to delete it">
      <bpmn:incoming>f_deny_ask</bpmn:incoming>
      <bpmn:outgoing>f_ask_want</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="want" name="Delete it?">
      <bpmn:incoming>f_ask_want</bpmn:incoming>
      <bpmn:outgoing>f_want_kept</bpmn:outgoing>
      <bpmn:outgoing>f_want_del</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="kept" name="Snapshot kept">
      <bpmn:incoming>f_want_kept</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="del" name="4 Run the delete with !">
      <bpmn:incoming>f_want_del</bpmn:incoming>
      <bpmn:outgoing>f_del_gone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="gone" name="Snapshot deleted">
      <bpmn:incoming>f_del_gone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_run" sourceRef="start" targetRef="run" />
    <bpmn:sequenceFlow id="f_run_deny" sourceRef="run" targetRef="deny" />
    <bpmn:sequenceFlow id="f_deny_ask" sourceRef="deny" targetRef="ask" />
    <bpmn:sequenceFlow id="f_ask_want" sourceRef="ask" targetRef="want" />
    <bpmn:sequenceFlow id="f_want_kept" name="no" sourceRef="want" targetRef="kept" />
    <bpmn:sequenceFlow id="f_want_del" name="yes" sourceRef="want" targetRef="del" />
    <bpmn:sequenceFlow id="f_del_gone" sourceRef="del" targetRef="gone" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_docs_delete_collab">
    <bpmndi:BPMNPlane id="BPMNPlane_docs_delete_collab" bpmnElement="docs_delete_collab">
      <bpmndi:BPMNShape id="BPMNShape_docs_delete_pool" bpmnElement="docs_delete_pool" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1663.2" height="793" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_0" bpmnElement="lane_0" bioc:stroke="#08427b" bioc:fill="#c3d4e7" color:border-color="#08427b" color:background-color="#c3d4e7" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="1633.2" height="481" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_1" bpmnElement="lane_1" bioc:stroke="#6b4fbb" bioc:fill="#dcd3f2" color:border-color="#6b4fbb" color:background-color="#dcd3f2" isHorizontal="true">
        <dc:Bounds x="110" y="561" width="1633.2" height="312" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start" bioc:stroke="#6b4fbb" bioc:fill="#ffffff" color:border-color="#6b4fbb" color:background-color="#ffffff">
        <dc:Bounds x="180.8" y="699" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="162.97500000000002" y="753.2" width="73" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_run" bpmnElement="run" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="375.6" y="677" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_deny" bpmnElement="deny" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="645.6" y="677" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ask" bpmnElement="ask" bioc:stroke="#402f70" bioc:fill="#6b4fbb" color:border-color="#402f70" color:background-color="#6b4fbb">
        <dc:Bounds x="915.6" y="677" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_want" bpmnElement="want" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff" isMarkerVisible="true">
        <dc:Bounds x="1176.8500000000001" y="191.5" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1087.7250000000001" y="165.3" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_kept" bpmnElement="kept" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff">
        <dc:Bounds x="1420.1000000000001" y="198.5" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1407.1000000000001" y="250.60000000000002" width="62" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_del" bpmnElement="del" bioc:stroke="#05284a" bioc:fill="#08427b" color:border-color="#05284a" color:background-color="#08427b">
        <dc:Bounds x="1388.1000000000001" y="365" width="100" height="80" /><bpmndi:BPMNLabel color:color="#ffffff" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gone" bpmnElement="gone" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff">
        <dc:Bounds x="1646.9" y="387" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1633.9" y="439.1" width="62" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_start_run" bpmnElement="f_start_run" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="216.8" y="717" /><di:waypoint x="375.6" y="717" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_run_deny" bpmnElement="f_run_deny" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="475.6" y="717" /><di:waypoint x="645.6" y="717" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_deny_ask" bpmnElement="f_deny_ask" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="745.6" y="717" /><di:waypoint x="915.6" y="717" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_ask_want" bpmnElement="f_ask_want" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1015.6" y="717" /><di:waypoint x="1201.8500000000001" y="717" /><di:waypoint x="1201.8500000000001" y="241.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_want_kept" bpmnElement="f_want_kept" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1226.8500000000001" y="216.5" /><di:waypoint x="1420.1000000000001" y="216.5" /><bpmndi:BPMNLabel><dc:Bounds x="1369.7" y="190" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_want_del" bpmnElement="f_want_del" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1226.8500000000001" y="216.5" /><di:waypoint x="1343.6000000000001" y="216.5" /><di:waypoint x="1343.6000000000001" y="405" /><di:waypoint x="1388.1000000000001" y="405" /><bpmndi:BPMNLabel><dc:Bounds x="1354.7250000000001" y="304.4" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_del_gone" bpmnElement="f_del_gone" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="1488.1000000000001" y="405" /><di:waypoint x="1646.9" y="405" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
