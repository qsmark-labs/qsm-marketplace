          <dc:Bounds x="2637.4" y="268" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_start_find" bpmnElement="f_start_find" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="216.8" y="548" /><di:waypoint x="375.6" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_find_touched" bpmnElement="f_find_touched" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="475.6" y="548" /><di:waypoint x="636.85" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_touched_say" bpmnElement="f_touched_say" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="686.85" y="548" /><di:waypoint x="848.1" y="548" /><bpmndi:BPMNLabel><dc:Bounds x="754.1" y="521.5" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_say_openJoin" bpmnElement="f_say_openJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="948.1" y="548" /><di:waypoint x="1885.6000000000001" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_openJoin_open" bpmnElement="f_openJoin_open" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1935.6000000000001" y="548" /><di:waypoint x="2130.6000000000004" y="548" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_open_read" bpmnElement="f_open_read" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="2230.6000000000004" y="548" /><di:waypoint x="2450.6000000000004" y="548" /><di:waypoint x="2450.6000000000004" y="276" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_read_end" bpmnElement="f_read_end" bioc:stroke="#08427b" color:border-color="#08427b"><di:waypoint x="2500.6000000000004" y="236" /><di:waypoint x="2659.4" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_enough_openJoin" bpmnElement="f_enough_openJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="1699.3500000000001" y="756" /><di:waypoint x="1910.6000000000001" y="756" /><di:waypoint x="1910.6000000000001" y="573" /><bpmndi:BPMNLabel><dc:Bounds x="1797.525" y="729.5" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_touched_drawJoin" bpmnElement="f_touched_drawJoin" bioc:stroke="#6b4fbb" color:border-color="#6b4fbb"><di:waypoint x="661.85" y="573" /><di:waypoint x="661.85" y="756" /><di:waypoint x="873.1" y="756" /><bpmndi:BPMNLabel><dc:Bounds x="672.975" y="661.9" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
