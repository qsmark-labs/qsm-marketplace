      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end" bioc:stroke="#08427b" bioc:fill="#ffffff" color:border-color="#08427b" color:background-color="#ffffff">
        <dc:Bounds x="2659.4" y="218" width="36" height="36" />
