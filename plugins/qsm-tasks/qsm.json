{
  "name": "qsm-tasks",
  "qsm": {
    "bin": {
      "qsm-tasks": "scripts/cli.ts"
    },
    "noun": "tasks",
    "commands": {
      "qsm-tasks ready": {
        "description": "List the open Todo tasks and bugs, unblocked and not deferred, by Priority then number",
        "args": [
          {
            "name": "feature",
            "type": "number",
            "description": "only the sub-issues of this feature"
          },
          {
            "name": "qa",
            "type": "boolean",
            "description": "the features at Ready For Test instead"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks list": {
        "description": "List the open issues; with --feature or --spec, a feature's sub-issues or a change's feature, open and closed",
        "args": [
          {
            "name": "feature",
            "type": "number",
            "description": "the sub-issues of this feature"
          },
          {
            "name": "spec",
            "type": "string",
            "description": "the feature labelled change:<id>"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks show": {
        "description": "Print one issue: its facts, blockers, sub-issue counts, body and comments",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the issue"
          },
          {
            "name": "comments",
            "type": "boolean",
            "description": "its comments too, oldest first"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks feature": {
        "description": "File a Feature at Todo from an intent file",
        "args": [
          {
            "name": "goal",
            "type": "string",
            "positional": true,
            "required": true,
            "description": "the title"
          },
          {
            "name": "intent",
            "type": "string",
            "required": true,
            "description": "a file holding the intent: the body"
          },
          {
            "name": "spec",
            "type": "string",
            "description": "bind it to a change: the label change:<id>"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks add": {
        "description": "Add a Task as a sub-issue of an open feature",
        "args": [
          {
            "name": "title",
            "type": "string",
            "positional": true,
            "required": true,
            "description": "the title"
          },
          {
            "name": "feature",
            "type": "number",
            "description": "the open feature it is a sub-issue of"
          },
          {
            "name": "after",
            "type": "number",
            "description": "the issue it is blocked by"
          },
          {
            "name": "priority",
            "type": "string",
            "description": "P0, P1 or P2"
          },
          {
            "name": "bodyFile",
            "type": "string",
            "description": "a file holding the body"
          },
          {
            "name": "label",
            "type": "string",
            "repeatable": true,
            "description": "a label it carries"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks feedback": {
        "description": "File feedback on the marketplace as a plain issue from its template, with its labels"
      },
      "qsm-tasks edit": {
        "description": "Change an issue's title, priority, body, assignee, feature, order or change"
      },
      "qsm-tasks note": {
        "description": "Post one comment on an issue, the text unchanged",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the issue"
          },
          {
            "name": "text",
            "type": "string",
            "positional": true,
            "required": true,
            "description": "the comment"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks claim": {
        "description": "Take a Todo task or bug: In Dev, assigned to the caller, on the board",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the task or bug"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks unclaim": {
        "description": "Give a task back: Todo and unassigned, or deferred until a given value",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the task or bug"
          },
          {
            "name": "until",
            "type": "string",
            "description": "defer it: label deferred and comment Deferred until <value>"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks review": {
        "description": "Move a task or bug to Agent Review",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the task or bug"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks human": {
        "description": "Hand an approved task with green checks to the owner: Ready For Human, then Human Review"
      },
      "qsm-tasks close": {
        "description": "Close an issue with its reason as a comment, as completed or not planned"
      },
      "qsm-tasks reopen": {
        "description": "Reopen a closed task, bug or feedback under an open parent, at Todo",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the task, bug or feedback"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks plan": {
        "description": "Return a feature to Todo for planning",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the feature"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks qa": {
        "description": "Start the test of a feature at Ready For Test with no open sub-issue: In Test",
        "args": [
          {
            "name": "number",
            "type": "number",
            "positional": true,
            "required": true,
            "description": "the feature"
          },
          {
            "name": "repo",
            "type": "string",
            "description": "owner/name; default: gh's repository"
          },
          {
            "name": "project",
            "type": "string",
            "description": "owner/number; default: the linked board"
          }
        ]
      },
      "qsm-tasks doctor": {
        "description": "Check gh, the repository, the board, its fields, labels, workflows and views"
      },
      "qsm-tasks flow": {
        "description": "Print the Status and Priority tables: each Status per kind and each verb's guard"
      },
      "qsm-tasks setup": {
        "description": "Create the board's missing fields, options and labels; never rename or delete"
      }
    }
  }
}
