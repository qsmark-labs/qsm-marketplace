#!/usr/bin/env bash
# contrast — WCAG contrast of two regions of the live screen (`drive contrast A B`).
# A region is a geom selector (median colour of its rect, shrunk 2 physical px) or
# a logical "X,Y" point. Append @ink to a selector to take the pixel farthest from
# the median instead (the glyph colour inside a rect that is mostly background).
#   contrast each SEL --min R [--shot PNG] [--over SEL]: every visible match's ink against the median
#   of its own rect, leaving out the pixels under the --over matches (a cover by design).
# --shot reads a capture with the tree in GEOM_TREE instead of the live screen (an atlas check).
set -uo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

die() {
  printf 'drive contrast: %s\n' "$*" >&2
  exit 2
}

usage() { cat "$here/contrast.usage"; }

# stdin: "r g b" per pixel. Prints "r g b" of the median (mode=median) or of the pixel
# farthest from the median, or from the ground REF when given (mode=ink).
pick() {
  gawk -v mode="$1" -v ref="${2:-}" -f "$here/pick.awk"
}

# Logical rect "x y w h" -> physical crop "WxH+X+Y", shrunk by 2 physical px per side unless the
# third argument is 1 (a point, or a whole rect); never below 1 px.
crop_of() {
  awk -v s="$2" -v pt="${3:-0}" '{
    x = $1 * s; y = $2 * s; w = $3 * s; h = $4 * s
    if (!pt) { x += 2; y += 2; w -= 4; h -= 4 }
    if (w < 1) { x += w / 2; w = 1 }
    if (h < 1) { y += h / 2; h = 1 }
    printf "%dx%d+%d+%d\n", w, h, x, y
  }' <<<"$1"
}

# Prints "r g b" for one region spec.
sample() {
  local spec="$1" png="$2" scale="$3" mode=median rect crop pt=0 screen="$4"
  if [[ "$spec" =~ ^#([0-9a-fA-F]{6})$ ]]; then
    printf '%d %d %d\n' "0x${BASH_REMATCH[1]:0:2}" "0x${BASH_REMATCH[1]:2:2}" "0x${BASH_REMATCH[1]:4:2}"
    return
  fi
  if [[ "$spec" == *@ink ]]; then
    mode=ink
    spec="${spec%@ink}"
  fi
  if [[ "$spec" =~ ^-?[0-9.]+,-?[0-9.]+$ ]]; then
    rect="${spec%,*} ${spec#*,} 0 0"
    pt=1
  else
    rect="$("$here/geom" rect "$spec" --screen "$screen")" || exit 2
  fi
  crop="$(crop_of "$rect" "$scale" "$pt")"
  printf 'sample %s: logical %s -> crop %s (%s)\n' "$spec" "$rect" "$crop" "$mode" >&2
  magick "$png" -crop "$crop" +repage -depth 8 txt:- \
    | sed -n 's/.*(\([0-9]*\),\([0-9]*\),\([0-9]*\).*/\1 \2 \3/p' | pick "$mode"
}

# Prints "ink<TAB>ground" of one logical rect "x y w h" in a capture; nothing when it lies outside.
# The ground is the median of the rect's own pixels: a text or glyph rect is mostly what it is drawn
# on, and a label that fills its body (the count in a badge) has no other ground; its strokes pull
# the median slightly toward the ink, which errs low. $5 lists logical rects "x y w h ..." that lie
# over it by design (a count badge on its glyph): their pixels are not its ground. The ink is the
# node's own opaque colour ($4, "#rrggbb" or "#ffrrggbb") when it has one, because a 12 px stroke
# never reaches its full colour on screen (text declared at 4.50:1 measured 4.35); otherwise the
# pixel inside the rect farthest from the ground.
ink_on() {
  local crop px ground
  px="$(magick "$2" -crop "$(crop_of "$1" "$3")" +repage -depth 8 txt:- 2>/dev/null \
    | sed -n 's/.*(\([0-9]*\),\([0-9]*\),\([0-9]*\).*/\1 \2 \3/p')"
  [[ -n "$px" ]] || return 0
  # The whole rect, not the shrunk crop: inside a 16 px glyph's inner box its strokes are the median.
  crop="$(crop_of "$1" "$3" 1)"
  ground="$(magick "$2" -crop "$crop" +repage -depth 8 txt:- 2>/dev/null | awk -v s="$3" -v crop="$crop" -v over="${5:-}" '
      BEGIN { split(crop, c, /[x+]/); n = split(over, line, "\n")
        for (i = 1; i <= n; i++) if (split(line[i], f, " ") >= 4) {
          k++; ax[k] = f[1] * s - c[3]; ay[k] = f[2] * s - c[4]; bx[k] = ax[k] + f[3] * s; by[k] = ay[k] + f[4] * s } }
      /^[0-9]+,[0-9]+:/ { split($1, p, /[,:]/); for (i = 1; i <= k; i++) if (p[1] >= ax[i] && p[1] < bx[i] && p[2] >= ay[i] && p[2] < by[i]) next
        match($0, /\(([0-9]+),([0-9]+),([0-9]+)/, m); print m[1], m[2], m[3] }' | pick median)"
  [[ -n "$ground" ]] || return 0
  local ink
  if [[ "$4" =~ ^#(ff)?([0-9a-f]{6})$ ]]; then
    ink="$(printf '%d %d %d' "0x${BASH_REMATCH[2]:0:2}" "0x${BASH_REMATCH[2]:2:2}" "0x${BASH_REMATCH[2]:4:2}")"
  else
    ink="$(pick ink "$ground" <<<"$px")"
  fi
  printf '%s\t%s\n' "$ink" "$ground"
}

each() {
  local sel="$1" min="$2" shot="$3" screen="$4" over="$5" png scale rects pair overs=
  [[ -n "$min" ]] || die "each needs --min RATIO"
  if [[ -n "$shot" ]]; then
    [[ -f "$shot" && -f "${GEOM_TREE:-}" ]] || die "--shot needs a capture and its tree in GEOM_TREE"
    png="$shot"
    scale="$(awk -v a="$(magick identify -format '%w' "$png")" -v b="$(jq '.width' "$GEOM_TREE")" 'BEGIN { print a / b }')"
  else
    [[ -n "$screen" ]] || screen="$(hyprctl monitors -j | jq -r '.[]|select(.focused)|.name')"
    scale="$(hyprctl monitors -j | jq -r --arg m "$screen" '.[]|select(.name==$m)|.scale')"
    png="$("$here/drive" shot "$screen" contrast)" || exit 2
  fi
  rects="$("$here/geom" rects "$sel" ${screen:+--screen "$screen"})" || exit 2
  if [[ -n "$over" ]]; then overs="$("$here/geom" rects "$over" ${screen:+--screen "$screen"})" || exit 2; fi
  local x y w h type colour
  while read -r x y w h type colour; do
    [[ -n "$x" ]] || continue
    pair="$(ink_on "$x $y $w $h" "$png" "$scale" "${colour,,}" "$overs")"
    [[ -z "$pair" ]] || printf '%s\t%s\n' "$x $y $w $h $type" "$pair"
  done <<<"$rects" | gawk -v min="$min" -f "$here/lum.awk" -f "$here/each.awk"
}

main() {
  local pos=() screen="" min="" shot="" over=""
  while (($#)); do
    case "$1" in
      --screen) screen="${2:?--screen needs a value}" && shift 2 ;;
      --min) min="${2:?--min needs a value}" && shift 2 ;;
      --shot) shot="${2:?--shot needs a capture}" && shift 2 ;;
      --over) over="${2:?--over needs a selector}" && shift 2 ;;
      -h | --help) usage && return 0 ;;
      *) pos+=("$1") && shift ;;
    esac
  done
  command -v magick >/dev/null 2>&1 || die "missing magick (ImageMagick)"
  if [[ "${pos[0]:-}" == each && ${#pos[@]} == 2 ]]; then
    each "${pos[1]}" "$min" "$shot" "$screen" "$over"
    return
  fi
  ((${#pos[@]} == 2)) || {
    usage
    return 2
  }
  local scale=- png=- a b
  # Two literal colours need no screen.
  if [[ ! "${pos[0]}${pos[1]}" =~ ^#[0-9a-fA-F]{6}#[0-9a-fA-F]{6}$ ]]; then
    command -v grim >/dev/null 2>&1 || die "missing grim (see: drive doctor)"
    [[ -n "$screen" ]] || screen="$(hyprctl monitors -j | jq -r '.[]|select(.focused)|.name')"
    scale="$(hyprctl monitors -j | jq -r --arg m "$screen" '.[]|select(.name==$m)|.scale')"
    [[ -n "$scale" ]] || die "no monitor $screen"
    png="$("$here/drive" shot "$screen" contrast)" || exit 2
  fi
  a="$(sample "${pos[0]}" "$png" "$scale" "$screen")" || exit 2
  b="$(sample "${pos[1]}" "$png" "$scale" "$screen")" || exit 2
  awk -v a="$a" -v b="$b" -v pa="${pos[0]}" -v pb="${pos[1]}" -v min="$min" -v scale="$scale" -v png="$png" -f "$here/lum.awk" -f "$here/ratio.awk"
}

main "$@"
