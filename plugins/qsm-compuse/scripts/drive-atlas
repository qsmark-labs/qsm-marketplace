# shellcheck shell=bash disable=SC2154 # SLOT_* come from the slot state file, MOTION_DIR from drive
# Sourced by drive: the atlas verbs. A scenario names a desktop and its journeys; every journey
# runs in a fresh desktop slot, every `shot` step writes the screen and its item tree, and each
# run is kept beside the earlier ones and compared with the one before it, shot by shot.
#
# Scenario, one directive per line ('#' starts a comment, ~ is the home directory):
#   desktop PATH            the shell's Quickshell path (required)
#   hypr FILE               the Hyprland lua config the nested desktop reads
#   mock FILE               recorded readings the shell shows instead of live ones (DRIVE_MOCK)
#   settle SECONDS          the pause after each step (default 0.6)
#   ready SECONDS           the pause after the shell answers, before the first step (default 1);
#                           raise it past the timers a shell starts with
#   check CMD               the consumer's laws, run after every shot (see atlas_check)
#   journey NAME            starts a journey; the steps below belong to it
# Steps: the route steps (move-to X Y, hover-wait MS, press, release, click, key COMBO, wheel DY),
# plus type TEXT, exec CMD (a client started by the nested Hyprland), dispatch LUA, eval LUA (a
# config call such as a window rule), wait-clients N,
# ipc FN ARGS (the shell's own IPC, such as opening a surface), mock PATH JSON (one reading of the
# fake machine changed while the desktop runs, see slot_mock),
# shot NAME (taken once the screen is still), shot-now NAME (taken at once, for a state that times out);
# either may end in @Type, the item type of the surface it shows, which the board crops to; @A/B
# is the first B inside the first A, for a surface whose own type is generic, and A[n] the nth A
# (0 the first). ~@PATH after it masks an item that animates by design (a pulsing glyph): the shot
# waits for the rest of the screen, the comparison skips its rect, and its node leaves the tree.
# todo @Type STATE, anywhere: a state of that surface no journey shoots yet, an empty frame on the board.
#
# A run is <scenario>/<date>-<time>-<rng>/: board.html (the review board, see
# scripts/atlas-board.ts), shots/ (the captures as taken), trees/ (the item tree of each shot),
# logs/ (the shell's log per journey), checks/ (what the scenario's check printed per shot),
# diff-<run>/ (a comparison with that run, see atlas_compare).

ATLAS_ROOT="${DRIVE_ATLAS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/qsm/compuse/atlas}"
# A changed pixel differs by more than this share in one channel; a changed area is a connected
# region of at least this many pixels. Below both lies GPU noise.
ATLAS_FUZZ="${DRIVE_ATLAS_FUZZ:-3}"
ATLAS_MIN_AREA="${DRIVE_ATLAS_MIN_AREA:-16}"

atlas_path() { printf '%s\n' "${1/#\~/$HOME}"; }

# The scenario's settings as NAME=VALUE lines; they end at the first journey, whose own steps
# share some of their names (mock).
atlas_settings() {
  awk '$1 == "journey" { exit } $1 ~ /^(desktop|hypr|mock|settle|ready|check)$/ { k = $1; $1 = ""; sub(/^ /, ""); print k "=" $0 }' "$1"
}

# The steps of one journey, without indentation or comments.
atlas_steps() {
  awk -v j="$2" '
    /^[ \t]*(#|$)/ { next }
    $1 == "journey" { on = ($2 == j); next }
    $1 == "todo" { next }
    on { sub(/^[ \t]+/, ""); print }' "$1"
}

atlas_journeys() { awk '$1 == "journey" { print $2 }' "$1"; }

# ipc FN ARGS: a call into the shell's `qsm` IPC target, so a scenario opens a surface or posts
# mock data directly (a look and feel check, not a functional one). Quoted args keep their spaces.
atlas_ipc() {
  local split
  local -a args
  split="$(xargs -n1 printf '%s\n' <<<"$2" 2>&1)" || die "ipc arguments do not parse (an unmatched quote?): $2"
  mapfile -t args <<<"$split"
  (slot_run "$1" -- qs ipc --path "$SLOT_QS_PATH" call qsm "${args[@]}") >/dev/null || die "ipc failed: $2"
}

# wait-clients N: until the nested Hyprland maps exactly N windows (10 s at most).
atlas_wait_clients() {
  local i
  [[ "$2" =~ ^[0-9]+$ ]] || die "wait-clients needs a count"
  for ((i = 0; i < 40; i++)); do
    [[ "$( (slot_run "$1" -- hyprctl clients -j) | jq length)" == "$2" ]] && return
    sleep 0.25
  done
  die "the nested desktop never reached $2 windows"
}

# Waits until the shell answers its inspect call with a tree, so the first shot sees a loaded desktop.
atlas_wait_shell() {
  local i
  for ((i = 0; i < 60; i++)); do
    # A subshell: slot_tree dies (exits) while the shell is still loading.
    (slot_tree "$1") >/dev/null 2>&1 && return
    sleep 0.25
  done
  die "the shell in slot '$1' never answered (see $(slot_dir "$1")/qs.log)"
}

# Shoots OUT once two captures 150 ms apart show no changed area outside MASKS, so a shot never
# lands mid-animation; the last capture is the shot. A screen that never stills (a looping
# animation) is shot after 5 s and marked moving.
atlas_still() {
  local out="$1" masks="${2:-}" a="$1.still.png" i
  grim -o "$SLOT_OUTPUT" "$a" || die "grim failed in the atlas slot"
  for ((i = 0; i < 33; i++)); do
    sleep 0.15
    grim -o "$SLOT_OUTPUT" "$out" || die "grim failed in the atlas slot"
    if [[ -z "$(atlas_areas "$a" "$out" "$masks")" ]]; then
      rm -f "$a"
      echo still
      return
    fi
    command mv -f "$out" "$a"
  done
  command mv -f "$a" "$out"
  echo moving
}

# hyprctl exits 0 when the lua of a dispatch or eval fails and prints the error, so its output decides.
atlas_hyprctl() {
  [[ "$( (slot_run "$1" -- hyprctl "$2" "$3") 2>&1)" == ok ]] || die "$2 failed: $3"
}

atlas_step() {
  local slot="$1" line="$2" verb a b rest
  read -r verb a b rest <<<"$line"
  case "$verb" in
    type) slot_type "${line#type }" 0 ;;
    exec)
      [[ "$line" != *"]]"* ]] || die "an exec command must not hold ']]' (it is a lua long string): $line"
      atlas_hyprctl "$slot" dispatch "hl.dsp.exec_cmd([[${line#exec }]])"
      ;;
    dispatch) atlas_hyprctl "$slot" dispatch "${line#dispatch }" ;;
    eval) atlas_hyprctl "$slot" eval "${line#eval }" ;;
    wait-clients) atlas_wait_clients "$slot" "$a" ;;
    ipc) atlas_ipc "$slot" "${line#ipc }" ;;
    mock) slot_mock "$slot" "$a" "${line#mock "$a" }" ;;
    *) route_step "$verb" "$a" "$b" "$rest" || die "unknown atlas step '$line'" ;;
  esac
}

# Runs the scenario's check on one shot: CMD gets ATLAS_SHOT, ATLAS_TREE (also GEOM_TREE),
# ATLAS_JOURNEY, ATLAS_NAME and DRIVE_SLOT; what it prints goes to checks/NAME.txt. A line ending
# ": FAIL" is a failed law, exit 0 or 1 is a verdict, any other exit means the check could not run.
# Prints the count of failed laws, or "error".
atlas_check() {
  local cmd="$1" run="$2" journey="$3" name="$4" slot="$5" rc
  ATLAS_SHOT="$run/shots/$name.png" ATLAS_TREE="$run/trees/$name.json" GEOM_TREE="$run/trees/$name.json" \
    ATLAS_JOURNEY="$journey" ATLAS_NAME="$name" DRIVE_SLOT="$slot" bash -c "$cmd" >"$run/checks/$name.txt" 2>&1
  rc=$?
  if ((rc > 1)); then echo error; else grep -c ': FAIL$' "$run/checks/$name.txt"; fi
}

# A surface or mask path: types (letters, digits, underscore), each with an optional [n], joined by /.
export ATLAS_PATH='^[A-Za-z0-9_]+(\[[0-9]+\])?(/[A-Za-z0-9_]+(\[[0-9]+\])?)*$'

# Takes a shot's masked items out of its TREE and prints their rects in device px (the slot's scale).
atlas_mask() {
  local name="$1" tree="$2"
  shift 2
  bun "$MOTION_DIR/atlas-board.ts" mask "$tree" "$SLOT_SCALE" "$@" ||
    die "shot $name masks $*, and its item tree holds no such item with a size"
}

# One journey in a fresh desktop slot; prints
# "journey<TAB>shot<TAB>step<TAB>still<TAB>fails<TAB>surface<TAB>masks" per shot.
atlas_journey() {
  local scenario="$1" journey="$2" run="$3" slot="$4" settle="$5" ready="$6" check="$7" n line shot surface name still fails
  local rest word rects tree
  local -a steps words masks
  shift 7
  slot_start "$slot" "$@" >/dev/null
  export DRIVE_SLOT="$slot"
  slot_load "$slot"
  atlas_wait_shell "$slot"
  sleep "$ready"
  mapfile -t steps < <(atlas_steps "$scenario" "$journey")
  for ((n = 0; n < ${#steps[@]}; n++)); do
    line="${steps[n]}"
    if [[ "$line" == shot\ * || "$line" == shot-now\ * ]]; then
      read -r _ shot rest <<<"$line"
      read -ra words <<<"$rest"
      name="$journey--$shot" surface="" masks=() rects=""
      [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "shot names are letters, digits, dot, dash and underscore: '$name'"
      for word in "${words[@]}"; do
        [[ "${word#*@}" =~ $ATLAS_PATH ]] ||
          die "shot $name: '$word' names no item path (letters, digits, underscore, [n]; A/B for a path)"
        case "$word" in
          @*) [[ -z "$surface" ]] || die "shot $name names two surfaces"; surface="${word#@}" ;;
          ~@*) masks+=("${word#~@}") ;;
          *) die "shot $name: '$word' is neither @SURFACE nor ~@MASK" ;;
        esac
      done
      tree="$run/trees/$name.json"
      # A mask is found before the shot waits, so the wait ignores it from the first capture.
      if ((${#masks[@]})); then
        slot_tree "$slot" >"$tree"
        # die in a command substitution ends only the subshell.
        rects="$(atlas_mask "$name" "$tree" "${masks[@]}")" || exit 1
      fi
      # shot-now catches a state that times out (an armed button), so it waits for nothing.
      if [[ "$line" == shot-now\ * ]]; then
        OUT_DIR="$run/shots" cmd_shot - "$name" >/dev/null
        still=now
      else
        still="$(atlas_still "$run/shots/$name.png" "$rects" "$tree")" || exit 1
      fi
      slot_tree "$slot" >"$tree"
      if ((${#masks[@]})); then rects="$(atlas_mask "$name" "$tree" "${masks[@]}")" || exit 1; fi
      # The board crops the shot to this item; a renamed component must stop the run, not uncrop it.
      [[ -z "$surface" ]] || bun "$MOTION_DIR/atlas-board.ts" surface "$run/trees/$name.json" "$surface" >/dev/null ||
        die "shot $name names @$surface, and its item tree holds no $surface with a size"
      fails=""
      [[ -z "$check" ]] || fails="$(atlas_check "$check" "$run" "$journey" "$name" "$slot")"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$journey" "$shot" "$((n + 1))" "$still" "$fails" "$surface" "$rects"
    else
      atlas_step "$slot" "$line"
      # A step right before shot-now gets no settle, or the state it caught is already gone.
      [[ "${steps[n + 1]:-}" == shot-now\ * ]] || sleep "$settle"
    fi
  done
  # The shell's log is the one record of what it saw; the slot dir goes with the slot.
  command cp "$(slot_dir "$slot")/qs.log" "$run/logs/$journey.qs.log"
  slot_kill "$slot"
  unset DRIVE_SLOT
}

# A run is built under a dot name and renamed when it completes, so a failed run is never a baseline.
atlas_run() {
  local scenario="${1:-}" desktop="" hypr="" mock="" check="" settle=0.6 ready=1 opt dir id run slot journey prev failed
  local -a start
  [[ -f "$scenario" ]] || die "atlas run needs a SCENARIO file"
  while IFS= read -r opt; do printf -v "${opt%%=*}" '%s' "${opt#*=}"; done < <(atlas_settings "$scenario")
  desktop="$(atlas_path "$desktop")"
  hypr="$(atlas_path "$hypr")"
  mock="$(atlas_path "$mock")"
  check="$(atlas_path "$check")"
  [[ -n "$desktop" ]] || die "the scenario names no desktop"
  [[ -n "$(atlas_journeys "$scenario")" ]] || die "the scenario has no journey"
  opt="$(awk '$1 == "todo" && !(substr($2, 1, 1) == "@" && substr($2, 2) ~ ENVIRON["ATLAS_PATH"] && NF >= 3) { print NR ": " $0; exit }' "$scenario")"
  [[ -z "$opt" ]] || die "a todo line is 'todo @Type STATE': line $opt"
  # A pause that sleep refuses would be no pause at all, and the race it covers would pass.
  for opt in settle ready; do
    [[ "${!opt}" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "$opt needs SECONDS, a number: '${!opt}'"
  done
  dir="$ATLAS_ROOT/$(basename "${scenario%.*}")"
  prev="$(atlas_runs "$dir" | tail -1)"
  id="$(date +%Y%m%d-%H%M%S)-$(printf '%04x' "$RANDOM")"
  run="$dir/.$id"
  mkdir -p "$run/shots" "$run/trees" "$run/logs" "$run/checks"
  command cp "$scenario" "$run/scenario"
  printf '%s\n' "$(git -C "$desktop" describe --always --dirty 2>/dev/null || echo unknown)" >"$run/desktop-version"
  slot="at$((RANDOM % 10000))"
  start=(--desktop "$desktop")
  [[ -z "$hypr" ]] || start+=(--hypr "$hypr")
  [[ -z "$mock" ]] || start+=(--mock "$mock")
  trap 'slot_kill "'"$slot"'" 2>/dev/null; rm -rf "'"$run"'"' EXIT
  for journey in $(atlas_journeys "$scenario"); do
    printf 'journey %s\n' "$journey" >&2
    atlas_journey "$scenario" "$journey" "$run" "$slot" "$settle" "$ready" "$check" "${start[@]}" >>"$run/shots.tsv"
  done
  trap - EXIT
  command mv "$run" "$dir/$id"
  run="$dir/$id"
  if [[ -n "$prev" ]]; then atlas_compare "$dir/$prev" "$run"; fi
  atlas_board "$run" "$prev"
  printf '%s/board.html\n' "$run"
  # The run is kept either way; the exit code tells an agent a law failed.
  failed="$(awk -F'\t' '$5 != "" && $5 != "0"' "$run/shots.tsv" | wc -l)"
  ((failed == 0)) || die "$failed shots failed their check (see checks/ in the run)"
}

# The completed runs of one scenario dir, oldest first.
atlas_runs() { find "$1" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' -printf '%f\n' 2>/dev/null | sort; }

# The changed areas of one shot: "x y w h" per connected region over the noise floor. An area
# inside a mask (MASKS as x,y,w,h;... in device px, 2 px slack) is the animation it masks, not a
# change.
atlas_areas() {
  magick "$1" "$2" -compose difference -composite -separate -evaluate-sequence max \
    -threshold "$ATLAS_FUZZ%" -define connected-components:verbose=true \
    -define connected-components:area-threshold="$ATLAS_MIN_AREA" -connected-components 8 null: \
    | awk -v masks="${3:-}" 'BEGIN { n = split(masks, m, ";") }
      /gray\(255\)|#FFFFFF|white/ { split($2, g, /[x+]/); x = g[3]; y = g[4]; w = g[1]; h = g[2]
        for (i = 1; i <= n; i++) { split(m[i], r, ",")
          if (x >= r[1] - 2 && y >= r[2] - 2 && x + w <= r[1] + r[3] + 2 && y + h <= r[2] + r[4] + 2) next }
        print x, y, w, h }'
}

# Every measure of a shot's item tree as "key<TAB>value", the key a path of types and same-type
# sibling indices plus the measure: #rect (x y w h, logical px), #radius, #color, #opacity, #text, and
# #gap-y / #gap-x from an item to the next sibling below or to its right that it lines up with.
atlas_measures() {
  jq -r 'def r1: (. * 10 | round) / 10;
    def named($p): (.children // []) as $k | [range(0; $k | length) | . as $i | $k[$i]
      + {_p: ($p + "/" + $k[$i].type + "[" + ([$k[:$i][] | select(.type == $k[$i].type)] | length | tostring) + "]")}];
    def gaps: [.[] | select(.w > 0 and .h > 0)] as $k
      | (($k | sort_by(.y, .x)) as $v | range(1; $v | length) as $i | $v[$i - 1] as $a | $v[$i] as $b
          | select($a.x < $b.x + $b.w and $b.x < $a.x + $a.w and $b.y >= $a.y + $a.h)
          | ["\($a._p)#gap-y:\($b._p | split("/") | last)", ($b.y - $a.y - $a.h | r1 | tostring)]),
        (($k | sort_by(.x, .y)) as $v | range(1; $v | length) as $i | $v[$i - 1] as $a | $v[$i] as $b
          | select($a.y < $b.y + $b.h and $b.y < $a.y + $a.h and $b.x >= $a.x + $a.w)
          | ["\($a._p)#gap-x:\($b._p | split("/") | last)", ($b.x - $a.x - $a.w | r1 | tostring)]);
    def measures($p): ["\($p)#rect", "\(.x | round) \(.y | round) \(.w | round) \(.h | round)"],
      (select(.radius != null) | ["\($p)#radius", (.radius | tostring)]),
      (select(.color != null) | ["\($p)#color", .color]),
      (select(.opacity != null) | ["\($p)#opacity", (.opacity | tostring)]),
      (select(.text != null) | ["\($p)#text", .text]),
      (named($p) as $k | ($k | gaps), ($k[] | measures(._p)));
    .tree | measures(.type) | join("\t")' "$1" || die "not an item tree: $1"
}

# Run B against run A, per shot both hold, into B/diff-<A>/: NAME.png (run A beside run B, each
# changed area boxed, B's changed pixels marked), NAME.areas (x y w h, device px), NAME.measures
# (key, before, after for every measure that changed) and diff.json (the same per shot: areas
# and changes), which the board reads.
atlas_compare() {
  local a="$1" b="$2" out png name masks areas draw x y w h width
  out="$b/diff-$(basename "$a")"
  rm -rf "$out"
  mkdir -p "$out"
  # Two runs may share no shot, and diff.json is then an empty list.
  : >"$out/diff.jsonl"
  for png in "$b"/shots/*.png; do
    name="$(basename "$png" .png)"
    [[ -f "$a/shots/$name.png" ]] || continue
    masks="$(awk -F'\t' -v n="$name" '$1 "--" $2 == n { print $7 }' "$b/shots.tsv")"
    areas="$(atlas_areas "$a/shots/$name.png" "$png" "$masks" | tee "$out/$name.areas" | wc -l)"
    if ((areas > 0)); then
      width="$(magick identify -format '%w' "$png")"
      draw=""
      while read -r x y w h; do
        draw+=" rectangle $((x - 3)),$((y - 3)) $((x + w + 2)),$((y + h + 2))"
        draw+=" rectangle $((width + x - 3)),$((y - 3)) $((width + x + w + 2)),$((y + h + 2))"
      done <"$out/$name.areas"
      magick "$a/shots/$name.png" \( "$png" \( "$a/shots/$name.png" "$png" -compose difference -composite -separate \
        -evaluate-sequence max -threshold "$ATLAS_FUZZ%" -fill '#ff3df0' -opaque white -transparent black \) \
        -compose over -composite \) +append -fill none -stroke '#ff3df0' -strokewidth 3 -draw "$draw" "$out/$name.png"
    fi
    join -t $'\t' -a1 -a2 -e GONE -o 0,1.2,2.2 <(atlas_measures "$a/trees/$name.json" | sort) \
      <(atlas_measures "$b/trees/$name.json" | sort) | awk -F'\t' '$2 != $3' >"$out/$name.measures"
    jq -cn --arg name "$name" --rawfile areas "$out/$name.areas" --rawfile changes "$out/$name.measures" '{name: $name,
      areas: [$areas | splits("\n") | select(length > 0) | split(" ") | map(tonumber) | {x: .[0], y: .[1], w: .[2], h: .[3]}],
      changes: [$changes | splits("\n") | select(length > 0) | split("\t") | {key: .[0], before: .[1], after: .[2]}]}' >>"$out/diff.jsonl"
  done
  jq -s . "$out/diff.jsonl" >"$out/diff.json" && rm -f "$out/diff.jsonl"
}

# atlas diff RUN [AGAINST]: compare any two kept runs (paths); AGAINST defaults to the run before RUN.
atlas_diff() {
  local run="${1%/}" against="${2%/}" prev
  [[ -f "$run/shots.tsv" ]] || die "atlas diff needs a RUN dir (one with shots.tsv)"
  if [[ -z "$against" ]]; then
    prev="$(atlas_runs "$(dirname "$run")" | awk -v r="$(basename "$run")" '$0 == r { print p; exit } { p = $0 }')"
    [[ -n "$prev" ]] || die "no run before $(basename "$run") to compare with"
    against="$(dirname "$run")/$prev"
  fi
  [[ -f "$against/shots.tsv" ]] || die "AGAINST '$against' is not a run dir"
  # The board links the earlier run's shots beside this one, so both live in one scenario dir.
  [[ "$(readlink -f "$(dirname "$against")")" == "$(readlink -f "$(dirname "$run")")" ]] ||
    die "AGAINST '$against' is a run of another scenario than RUN"
  atlas_compare "$against" "$run"
  atlas_board "$run" "$(basename "$against")"
  printf '%s/board.html\n' "$run"
}

# The review board of a run (scripts/atlas-board.ts): a run whose board did not build fails.
atlas_board() {
  bun "$MOTION_DIR/atlas-board.ts" build "$1" "$2" || die "the board of $1 did not build"
}

# The scenario dir a review or a comment list is about: a SCENARIO file or name, else the one
# whose last run is the newest.
atlas_dir() {
  local name="${1:-}"
  [[ -n "$name" ]] || name="$(find "$ATLAS_ROOT" -mindepth 2 -maxdepth 2 -type d -name '[0-9]*' -printf '%f %h\n' 2>/dev/null |
    sort | tail -1 | cut -d' ' -f2-)"
  name="$(basename "$name")"
  name="${name%.*}"
  [[ -n "$name" && -d "$ATLAS_ROOT/$name" ]] || die "no atlas runs for '${1:-any scenario}' under $ATLAS_ROOT"
  printf '%s/%s\n' "$ATLAS_ROOT" "$name"
}

cmd_atlas() {
  local verb="${1:-}" d
  shift || true
  case "$verb" in
    run) atlas_run "$@" ;;
    diff) atlas_diff "$@" ;;
    ls) for d in "$ATLAS_ROOT"/*/; do [[ -d "$d" ]] && printf '%s %s\n' "$(basename "$d")" "$(atlas_runs "$d" | tr '\n' ' ')"; done ;;
    review) d="$(atlas_dir "${1:-}")" && exec bun "$MOTION_DIR/atlas-board.ts" serve "$d" ;;
    comments) d="$(atlas_dir "${1:-}")" && bun "$MOTION_DIR/atlas-board.ts" comments "$d" ;;
    *) die "atlas needs run SCENARIO | diff RUN [AGAINST] | review [SCENARIO] | comments [SCENARIO] | ls" ;;
  esac
}
