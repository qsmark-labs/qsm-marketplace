<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="marketplace_defs" targetNamespace="urn:qsm:marketplace">
  <bpmn:collaboration id="feature_flow_collab">
    <bpmn:participant id="feature_flow_pool" name="A feature from request to main" processRef="feature_flow_process" />
  </bpmn:collaboration>
  <bpmn:process id="feature_flow_process" name="A feature from request to main" isExecutable="false">
    <bpmn:laneSet id="feature_flow_process_laneset">
      <bpmn:lane id="feature_flow_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>land</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_flow_process_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_flow_process_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="feature_flow_process_lane_1" name="Agent">
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_flow_process_dropped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buildJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_flow_process_build</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="feature_flow_process_lane_2" name="GitHub">
        <bpmn:flowNodeRef>feature_flow_process_sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_flow_process_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_flow_process_conflictTask</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="feature_flow_process_lane_3" name="QA agent">
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>holds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_flow_process_fixTask</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Feature needed">
      <bpmn:outgoing>f_need_request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="request" name="1 File the feature request">
      <bpmn:incoming>f_need_request</bpmn:incoming>
      <bpmn:outgoing>f_request_plan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="plan" name="2 Plan the feature" calledElement="plan_process">
      <bpmn:incoming>f_request_plan</bpmn:incoming>
      <bpmn:outgoing>f_plan_planned</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="planned" name="Plan approved?">
      <bpmn:incoming>f_plan_planned</bpmn:incoming>
      <bpmn:outgoing>f_planned_split</bpmn:outgoing>
      <bpmn:outgoing>f_planned_dropped</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="feature_flow_process_dropped" name="Feature not planned">
      <bpmn:incoming>f_planned_dropped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="split" name="3 Split the feature into tasks" calledElement="split_process">
      <bpmn:incoming>f_planned_split</bpmn:incoming>
      <bpmn:outgoing>f_split_buildJoin</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="buildJoin">
      <bpmn:incoming>f_split_buildJoin</bpmn:incoming>
      <bpmn:incoming>f_conflictTask_buildJoin</bpmn:incoming>
      <bpmn:incoming>f_fixTask_buildJoin</bpmn:incoming>
      <bpmn:incoming>f_accepted_buildJoin</bpmn:incoming>
      <bpmn:outgoing>f_buildJoin_build</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="feature_flow_process_build" name="4-6 Build every open task" calledElement="build_task_process">
      <bpmn:incoming>f_buildJoin_build</bpmn:incoming>
      <bpmn:outgoing>f_build_sync</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:callActivity>
    <bpmn:serviceTask id="feature_flow_process_sync" name="7.1 Merge main into feature/&#60;n&#62;">
      <bpmn:incoming>f_build_sync</bpmn:incoming>
      <bpmn:outgoing>feature_flow_process_f_sync_conflict</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="feature_flow_process_conflict" name="Conflict?">
      <bpmn:incoming>feature_flow_process_f_sync_conflict</bpmn:incoming>
      <bpmn:outgoing>feature_flow_process_f_conflict_conflictTask</bpmn:outgoing>
      <bpmn:outgoing>f_conflict_qa</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="feature_flow_process_conflictTask" name="7.2 File a conflict task">
      <bpmn:incoming>feature_flow_process_f_conflict_conflictTask</bpmn:incoming>
      <bpmn:outgoing>f_conflictTask_buildJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="qa" name="8.1 Test the feature in a sandbox">
      <bpmn:incoming>f_conflict_qa</bpmn:incoming>
      <bpmn:outgoing>f_qa_holds</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="holds" name="Contracts hold?">
      <bpmn:incoming>f_qa_holds</bpmn:incoming>
      <bpmn:outgoing>f_holds_fixTask</bpmn:outgoing>
      <bpmn:outgoing>f_holds_land</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="feature_flow_process_fixTask" name="8.2 File a fix task per finding">
      <bpmn:incoming>f_holds_fixTask</bpmn:incoming>
      <bpmn:outgoing>f_fixTask_buildJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="land" name="9 Land the feature on main" calledElement="land_process">
      <bpmn:incoming>f_holds_land</bpmn:incoming>
      <bpmn:outgoing>f_land_accepted</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="feature_flow_process_accepted" name="Feature accepted?">
      <bpmn:incoming>f_land_accepted</bpmn:incoming>
      <bpmn:outgoing>f_accepted_done</bpmn:outgoing>
      <bpmn:outgoing>f_accepted_buildJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="feature_flow_process_done" name="Feature closed on main">
      <bpmn:incoming>f_accepted_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_need_request" sourceRef="need" targetRef="request" />
    <bpmn:sequenceFlow id="f_request_plan" sourceRef="request" targetRef="plan" />
    <bpmn:sequenceFlow id="f_plan_planned" sourceRef="plan" targetRef="planned" />
    <bpmn:sequenceFlow id="f_planned_split" name="Plan approved" sourceRef="planned" targetRef="split" />
    <bpmn:sequenceFlow id="f_planned_dropped" name="Feature not planned" sourceRef="planned" targetRef="feature_flow_process_dropped" />
    <bpmn:sequenceFlow id="f_split_buildJoin" sourceRef="split" targetRef="buildJoin" />
    <bpmn:sequenceFlow id="f_buildJoin_build" sourceRef="buildJoin" targetRef="feature_flow_process_build" />
    <bpmn:sequenceFlow id="f_build_sync" sourceRef="feature_flow_process_build" targetRef="feature_flow_process_sync" />
    <bpmn:sequenceFlow id="feature_flow_process_f_sync_conflict" sourceRef="feature_flow_process_sync" targetRef="feature_flow_process_conflict" />
    <bpmn:sequenceFlow id="feature_flow_process_f_conflict_conflictTask" name="yes" sourceRef="feature_flow_process_conflict" targetRef="feature_flow_process_conflictTask" />
    <bpmn:sequenceFlow id="f_conflictTask_buildJoin" sourceRef="feature_flow_process_conflictTask" targetRef="buildJoin" />
    <bpmn:sequenceFlow id="f_conflict_qa" name="no" sourceRef="feature_flow_process_conflict" targetRef="qa" />
    <bpmn:sequenceFlow id="f_qa_holds" sourceRef="qa" targetRef="holds" />
    <bpmn:sequenceFlow id="f_holds_fixTask" name="no" sourceRef="holds" targetRef="feature_flow_process_fixTask" />
    <bpmn:sequenceFlow id="f_fixTask_buildJoin" sourceRef="feature_flow_process_fixTask" targetRef="buildJoin" />
    <bpmn:sequenceFlow id="f_holds_land" name="yes" sourceRef="holds" targetRef="land" />
    <bpmn:sequenceFlow id="f_land_accepted" sourceRef="land" targetRef="feature_flow_process_accepted" />
    <bpmn:sequenceFlow id="f_accepted_done" name="Feature closed on main" sourceRef="feature_flow_process_accepted" targetRef="feature_flow_process_done" />
    <bpmn:sequenceFlow id="f_accepted_buildJoin" name="Changes asked" sourceRef="feature_flow_process_accepted" targetRef="buildJoin" />
  </bpmn:process>
  <bpmn:collaboration id="plan_collab">
    <bpmn:participant id="plan_pool" name="2 Plan the feature" processRef="plan_process" />
  </bpmn:collaboration>
  <bpmn:process id="plan_process" name="2 Plan the feature" isExecutable="false">
    <bpmn:laneSet id="plan_process_laneset">
      <bpmn:lane id="plan_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_verdict</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="plan_process_lane_1" name="Agent">
        <bpmn:flowNodeRef>plan_process_filed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>models</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_process_dropped</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="plan_process_filed" name="Feature request filed">
      <bpmn:outgoing>f_filed_context</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="plan_process_context" name="2.1 Gather the context">
      <bpmn:incoming>f_filed_context</bpmn:incoming>
      <bpmn:outgoing>f_context_intent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="intent" name="2.2 Write the intent">
      <bpmn:incoming>f_context_intent</bpmn:incoming>
      <bpmn:outgoing>f_intent_askJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="askJoin">
      <bpmn:incoming>f_intent_askJoin</bpmn:incoming>
      <bpmn:incoming>f_verdict_askJoin</bpmn:incoming>
      <bpmn:outgoing>f_askJoin_ask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="plan_process_ask" name="2.3 Ask the open questions">
      <bpmn:incoming>f_askJoin_ask</bpmn:incoming>
      <bpmn:outgoing>f_ask_answer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="answer" name="2.4 Answer the questions">
      <bpmn:incoming>f_ask_answer</bpmn:incoming>
      <bpmn:outgoing>f_answer_models</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="models" name="2.5 Draw the models" calledElement="model_gate_process">
      <bpmn:incoming>f_answer_models</bpmn:incoming>
      <bpmn:outgoing>f_models_specs</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="specs" name="2.6 Write the specs">
      <bpmn:incoming>f_models_specs</bpmn:incoming>
      <bpmn:outgoing>f_specs_read</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="plan_process_read" name="2.7 Read the plan">
      <bpmn:incoming>f_specs_read</bpmn:incoming>
      <bpmn:outgoing>plan_process_f_read_verdict</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="plan_process_verdict" name="Plan approved?">
      <bpmn:incoming>plan_process_f_read_verdict</bpmn:incoming>
      <bpmn:outgoing>f_verdict_commit</bpmn:outgoing>
      <bpmn:outgoing>f_verdict_askJoin</bpmn:outgoing>
      <bpmn:outgoing>f_verdict_close</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="plan_process_commit" name="2.8 Commit the change">
      <bpmn:incoming>f_verdict_commit</bpmn:incoming>
      <bpmn:outgoing>f_commit_update</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="update" name="2.9 Update the feature issue">
      <bpmn:incoming>f_commit_update</bpmn:incoming>
      <bpmn:outgoing>f_update_approved</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="plan_process_approved" name="Plan approved">
      <bpmn:incoming>f_update_approved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="plan_process_close" name="2.10 Close the feature as not planned">
      <bpmn:incoming>f_verdict_close</bpmn:incoming>
      <bpmn:outgoing>f_close_dropped</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="plan_process_dropped" name="Feature not planned">
      <bpmn:incoming>f_close_dropped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_filed_context" sourceRef="plan_process_filed" targetRef="plan_process_context" />
    <bpmn:sequenceFlow id="f_context_intent" sourceRef="plan_process_context" targetRef="intent" />
    <bpmn:sequenceFlow id="f_intent_askJoin" sourceRef="intent" targetRef="askJoin" />
    <bpmn:sequenceFlow id="f_askJoin_ask" sourceRef="askJoin" targetRef="plan_process_ask" />
    <bpmn:sequenceFlow id="f_ask_answer" sourceRef="plan_process_ask" targetRef="answer" />
    <bpmn:sequenceFlow id="f_answer_models" sourceRef="answer" targetRef="models" />
    <bpmn:sequenceFlow id="f_models_specs" sourceRef="models" targetRef="specs" />
    <bpmn:sequenceFlow id="f_specs_read" sourceRef="specs" targetRef="plan_process_read" />
    <bpmn:sequenceFlow id="plan_process_f_read_verdict" sourceRef="plan_process_read" targetRef="plan_process_verdict" />
    <bpmn:sequenceFlow id="f_verdict_commit" name="yes" sourceRef="plan_process_verdict" targetRef="plan_process_commit" />
    <bpmn:sequenceFlow id="f_commit_update" sourceRef="plan_process_commit" targetRef="update" />
    <bpmn:sequenceFlow id="f_update_approved" sourceRef="update" targetRef="plan_process_approved" />
    <bpmn:sequenceFlow id="f_verdict_askJoin" name="changes" sourceRef="plan_process_verdict" targetRef="askJoin" />
    <bpmn:sequenceFlow id="f_verdict_close" name="dropped" sourceRef="plan_process_verdict" targetRef="plan_process_close" />
    <bpmn:sequenceFlow id="f_close_dropped" sourceRef="plan_process_close" targetRef="plan_process_dropped" />
  </bpmn:process>
  <bpmn:collaboration id="split_collab">
    <bpmn:participant id="split_pool" name="3 Split the feature into tasks" processRef="split_process" />
  </bpmn:collaboration>
  <bpmn:process id="split_process" name="3 Split the feature into tasks" isExecutable="false">
    <bpmn:laneSet id="split_process_laneset">
      <bpmn:lane id="split_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>split_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agreed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="split_process_lane_1" name="Agent">
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>push</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cutJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="approved" name="Plan approved">
      <bpmn:outgoing>f_approved_push</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="push" name="3.1 Push feature/&#60;n&#62;">
      <bpmn:incoming>f_approved_push</bpmn:incoming>
      <bpmn:outgoing>f_push_cutJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="cutJoin">
      <bpmn:incoming>f_push_cutJoin</bpmn:incoming>
      <bpmn:incoming>f_agreed_cutJoin</bpmn:incoming>
      <bpmn:outgoing>f_cutJoin_cut</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="cut" name="3.2 Cut the feature into tasks">
      <bpmn:incoming>f_cutJoin_cut</bpmn:incoming>
      <bpmn:outgoing>f_cut_read</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="split_process_read" name="3.3 Read the task list">
      <bpmn:incoming>f_cut_read</bpmn:incoming>
      <bpmn:outgoing>f_read_agreed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="agreed" name="Split agreed?">
      <bpmn:incoming>f_read_agreed</bpmn:incoming>
      <bpmn:outgoing>f_agreed_file</bpmn:outgoing>
      <bpmn:outgoing>f_agreed_cutJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="file" name="3.4 File the tasks under the feature">
      <bpmn:incoming>f_agreed_file</bpmn:incoming>
      <bpmn:outgoing>f_file_filed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="filed" name="Tasks filed">
      <bpmn:incoming>f_file_filed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_approved_push" sourceRef="approved" targetRef="push" />
    <bpmn:sequenceFlow id="f_push_cutJoin" sourceRef="push" targetRef="cutJoin" />
    <bpmn:sequenceFlow id="f_cutJoin_cut" sourceRef="cutJoin" targetRef="cut" />
    <bpmn:sequenceFlow id="f_cut_read" sourceRef="cut" targetRef="split_process_read" />
    <bpmn:sequenceFlow id="f_read_agreed" sourceRef="split_process_read" targetRef="agreed" />
    <bpmn:sequenceFlow id="f_agreed_file" name="yes" sourceRef="agreed" targetRef="file" />
    <bpmn:sequenceFlow id="f_agreed_cutJoin" name="no" sourceRef="agreed" targetRef="cutJoin" />
    <bpmn:sequenceFlow id="f_file_filed" sourceRef="file" targetRef="filed" />
  </bpmn:process>
  <bpmn:collaboration id="build_task_collab">
    <bpmn:participant id="build_task_pool" name="4-6 Build every open task" processRef="build_task_process" />
  </bpmn:collaboration>
  <bpmn:process id="build_task_process" name="4-6 Build every open task" isExecutable="false">
    <bpmn:laneSet id="build_task_process_laneset">
      <bpmn:lane id="build_task_process_lane_0" name="Agent">
        <bpmn:flowNodeRef>build_task_process_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comments</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="build_task_process_lane_1" name="Review agent">
        <bpmn:flowNodeRef>reviewJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build_task_process_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build_task_process_findings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="build_task_process_lane_2" name="Owner">
        <bpmn:flowNodeRef>build_task_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build_task_process_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="GitHub">
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="build_task_process_open" name="Task open">
      <bpmn:outgoing>f_open_build</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="build" name="4 Build the task into a PR" calledElement="consume_task_process">
      <bpmn:incoming>f_open_build</bpmn:incoming>
      <bpmn:outgoing>f_build_reviewJoin</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="reviewJoin">
      <bpmn:incoming>f_build_reviewJoin</bpmn:incoming>
      <bpmn:incoming>f_fix_reviewJoin</bpmn:incoming>
      <bpmn:incoming>f_comments_reviewJoin</bpmn:incoming>
      <bpmn:outgoing>f_reviewJoin_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="build_task_process_review" name="5.1 Review the PR">
      <bpmn:incoming>f_reviewJoin_review</bpmn:incoming>
      <bpmn:outgoing>build_task_process_f_review_findings</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="build_task_process_findings" name="Findings?">
      <bpmn:incoming>build_task_process_f_review_findings</bpmn:incoming>
      <bpmn:outgoing>f_findings_fix</bpmn:outgoing>
      <bpmn:outgoing>build_task_process_f_findings_read</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="fix" name="5.2 Fix the findings">
      <bpmn:incoming>f_findings_fix</bpmn:incoming>
      <bpmn:outgoing>f_fix_reviewJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="build_task_process_read" name="6.1 Read the PR">
      <bpmn:incoming>build_task_process_f_findings_read</bpmn:incoming>
      <bpmn:outgoing>f_read_accepted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="accepted" name="PR accepted?">
      <bpmn:incoming>f_read_accepted</bpmn:incoming>
      <bpmn:outgoing>f_accepted_merge</bpmn:outgoing>
      <bpmn:outgoing>f_accepted_comments</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="comments" name="6.2 Fix the owner&#39;s comments">
      <bpmn:incoming>f_accepted_comments</bpmn:incoming>
      <bpmn:outgoing>f_comments_reviewJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="build_task_process_merge" name="6.3 Merge the PR into feature/&#60;n&#62;">
      <bpmn:incoming>f_accepted_merge</bpmn:incoming>
      <bpmn:outgoing>f_merge_close</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="close" name="6.4 Close the task the PR names">
      <bpmn:incoming>f_merge_close</bpmn:incoming>
      <bpmn:outgoing>f_close_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="done" name="Task closed">
      <bpmn:incoming>f_close_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_open_build" sourceRef="build_task_process_open" targetRef="build" />
    <bpmn:sequenceFlow id="f_build_reviewJoin" sourceRef="build" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_reviewJoin_review" sourceRef="reviewJoin" targetRef="build_task_process_review" />
    <bpmn:sequenceFlow id="build_task_process_f_review_findings" sourceRef="build_task_process_review" targetRef="build_task_process_findings" />
    <bpmn:sequenceFlow id="f_findings_fix" name="some" sourceRef="build_task_process_findings" targetRef="fix" />
    <bpmn:sequenceFlow id="f_fix_reviewJoin" sourceRef="fix" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="build_task_process_f_findings_read" name="none" sourceRef="build_task_process_findings" targetRef="build_task_process_read" />
    <bpmn:sequenceFlow id="f_read_accepted" sourceRef="build_task_process_read" targetRef="accepted" />
    <bpmn:sequenceFlow id="f_accepted_merge" name="yes" sourceRef="accepted" targetRef="build_task_process_merge" />
    <bpmn:sequenceFlow id="f_accepted_comments" name="no" sourceRef="accepted" targetRef="comments" />
    <bpmn:sequenceFlow id="f_comments_reviewJoin" sourceRef="comments" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f_merge_close" sourceRef="build_task_process_merge" targetRef="close" />
    <bpmn:sequenceFlow id="f_close_done" sourceRef="close" targetRef="done" />
  </bpmn:process>
  <bpmn:collaboration id="consume_task_collab">
    <bpmn:participant id="consume_task_pool" name="4 Build the task into a PR" processRef="consume_task_process" />
  </bpmn:collaboration>
  <bpmn:process id="consume_task_process" name="4 Build the task into a PR" isExecutable="false">
    <bpmn:laneSet id="consume_task_process_laneset">
      <bpmn:lane id="consume_task_process_lane_0" name="Agent">
        <bpmn:flowNodeRef>consume_task_process_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>board</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>simplify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consume_task_process_pr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opened</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="consume_task_process_open" name="Task open">
      <bpmn:outgoing>f_open_claim</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="claim" name="4.1 Claim the task">
      <bpmn:incoming>f_open_claim</bpmn:incoming>
      <bpmn:outgoing>f_claim_context</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="context" name="4.2 Gather the context">
      <bpmn:incoming>f_claim_context</bpmn:incoming>
      <bpmn:outgoing>f_context_board</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="board" name="4.3 Draw the whiteboard">
      <bpmn:incoming>f_context_board</bpmn:incoming>
      <bpmn:outgoing>f_board_code</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="code" name="4.4 Write the code">
      <bpmn:incoming>f_board_code</bpmn:incoming>
      <bpmn:outgoing>f_code_simplify</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="simplify" name="4.5 Simplify the change">
      <bpmn:incoming>f_code_simplify</bpmn:incoming>
      <bpmn:outgoing>f_simplify_self</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="self" name="4.6 Review the change">
      <bpmn:incoming>f_simplify_self</bpmn:incoming>
      <bpmn:outgoing>f_self_pr</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="consume_task_process_pr" name="4.7 Open the PR into feature/&#60;n&#62;">
      <bpmn:incoming>f_self_pr</bpmn:incoming>
      <bpmn:outgoing>f_pr_opened</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="opened" name="PR open">
      <bpmn:incoming>f_pr_opened</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_open_claim" sourceRef="consume_task_process_open" targetRef="claim" />
    <bpmn:sequenceFlow id="f_claim_context" sourceRef="claim" targetRef="context" />
    <bpmn:sequenceFlow id="f_context_board" sourceRef="context" targetRef="board" />
    <bpmn:sequenceFlow id="f_board_code" sourceRef="board" targetRef="code" />
    <bpmn:sequenceFlow id="f_code_simplify" sourceRef="code" targetRef="simplify" />
    <bpmn:sequenceFlow id="f_simplify_self" sourceRef="simplify" targetRef="self" />
    <bpmn:sequenceFlow id="f_self_pr" sourceRef="self" targetRef="consume_task_process_pr" />
    <bpmn:sequenceFlow id="f_pr_opened" sourceRef="consume_task_process_pr" targetRef="opened" />
  </bpmn:process>
  <bpmn:collaboration id="land_collab">
    <bpmn:participant id="land_pool" name="9 Land the feature on main" processRef="land_process" />
  </bpmn:collaboration>
  <bpmn:process id="land_process" name="9 Land the feature on main" isExecutable="false">
    <bpmn:laneSet id="land_process_laneset">
      <bpmn:lane id="land_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>land_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="land_process_lane_1" name="Agent">
        <bpmn:flowNodeRef>passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>asked</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="passed" name="QA passed">
      <bpmn:outgoing>f_passed_pr</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="pr" name="9.1 Open the feature PR">
      <bpmn:incoming>f_passed_pr</bpmn:incoming>
      <bpmn:outgoing>f_pr_read</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="land_process_read" name="9.2 Read the feature PR">
      <bpmn:incoming>f_pr_read</bpmn:incoming>
      <bpmn:outgoing>f_read_verdict</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="verdict" name="Feature accepted?">
      <bpmn:incoming>f_read_verdict</bpmn:incoming>
      <bpmn:outgoing>f_verdict_archive</bpmn:outgoing>
      <bpmn:outgoing>f_verdict_fixTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="archive" name="9.3 Archive the change">
      <bpmn:incoming>f_verdict_archive</bpmn:incoming>
      <bpmn:outgoing>f_archive_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="merge" name="9.4 Merge the feature PR into main">
      <bpmn:incoming>f_archive_merge</bpmn:incoming>
      <bpmn:outgoing>f_merge_closed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="closed" name="Feature closed on main">
      <bpmn:incoming>f_merge_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="fixTask" name="9.5 File a fix task per change asked">
      <bpmn:incoming>f_verdict_fixTask</bpmn:incoming>
      <bpmn:outgoing>f_fixTask_asked</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="asked" name="Changes asked">
      <bpmn:incoming>f_fixTask_asked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_passed_pr" sourceRef="passed" targetRef="pr" />
    <bpmn:sequenceFlow id="f_pr_read" sourceRef="pr" targetRef="land_process_read" />
    <bpmn:sequenceFlow id="f_read_verdict" sourceRef="land_process_read" targetRef="verdict" />
    <bpmn:sequenceFlow id="f_verdict_archive" name="yes" sourceRef="verdict" targetRef="archive" />
    <bpmn:sequenceFlow id="f_archive_merge" sourceRef="archive" targetRef="merge" />
    <bpmn:sequenceFlow id="f_merge_closed" sourceRef="merge" targetRef="closed" />
    <bpmn:sequenceFlow id="f_verdict_fixTask" name="no" sourceRef="verdict" targetRef="fixTask" />
    <bpmn:sequenceFlow id="f_fixTask_asked" sourceRef="fixTask" targetRef="asked" />
  </bpmn:process>
  <bpmn:collaboration id="feature_status_collab">
    <bpmn:participant id="feature_status_pool" name="The Action derives a feature Status" processRef="feature_status_process" />
  </bpmn:collaboration>
  <bpmn:process id="feature_status_process" name="The Action derives a feature Status" isExecutable="false">
    <bpmn:laneSet id="feature_status_process_laneset">
      <bpmn:lane id="feature_status_process_lane_0" name="GitHub">
        <bpmn:flowNodeRef>event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_status_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stored</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>todoOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>toInDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTodo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feature_status_process_left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endWorking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>toReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflictTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endConflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDropped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readyOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backToDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReadyStays</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>toBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTestStays</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOther</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="event" name="A sub-issue opens, closes or reopens">
      <bpmn:outgoing>f_event_read</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="feature_status_process_read" name="Read the stored Status and the sub-issues">
      <bpmn:incoming>f_event_read</bpmn:incoming>
      <bpmn:outgoing>f_read_stored</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="stored" name="Stored Status?">
      <bpmn:incoming>f_read_stored</bpmn:incoming>
      <bpmn:outgoing>f_stored_todoOpen</bpmn:outgoing>
      <bpmn:outgoing>f_stored_left</bpmn:outgoing>
      <bpmn:outgoing>f_stored_readyOpen</bpmn:outgoing>
      <bpmn:outgoing>f_stored_testOpen</bpmn:outgoing>
      <bpmn:outgoing>f_stored_endOther</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="todoOpen" name="A sub-issue open?">
      <bpmn:incoming>f_stored_todoOpen</bpmn:incoming>
      <bpmn:outgoing>f_todoOpen_toInDev</bpmn:outgoing>
      <bpmn:outgoing>f_todoOpen_endTodo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="toInDev" name="Set In Dev">
      <bpmn:incoming>f_todoOpen_toInDev</bpmn:incoming>
      <bpmn:outgoing>f_toInDev_endSplit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSplit" name="Split: in development">
      <bpmn:incoming>f_toInDev_endSplit</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endTodo" name="Still planned: Todo">
      <bpmn:incoming>f_todoOpen_endTodo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="feature_status_process_left" name="Open sub-issue left?">
      <bpmn:incoming>f_stored_left</bpmn:incoming>
      <bpmn:outgoing>f_left_endWorking</bpmn:outgoing>
      <bpmn:outgoing>f_left_sync</bpmn:outgoing>
      <bpmn:outgoing>f_left_endDropped</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endWorking" name="Tasks still open: unchanged">
      <bpmn:incoming>f_left_endWorking</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="sync" name="Bring feature/&#60;n&#62; up to date with main">
      <bpmn:incoming>f_left_sync</bpmn:incoming>
      <bpmn:outgoing>f_sync_conflict</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="conflict" name="Conflict?">
      <bpmn:incoming>f_sync_conflict</bpmn:incoming>
      <bpmn:outgoing>f_conflict_conflictTask</bpmn:outgoing>
      <bpmn:outgoing>f_conflict_toReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="toReady" name="Set Ready For Test">
      <bpmn:incoming>f_conflict_toReady</bpmn:incoming>
      <bpmn:outgoing>f_toReady_endReady</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endReady" name="Waits for QA">
      <bpmn:incoming>f_toReady_endReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="conflictTask" name="File a conflict task under the feature">
      <bpmn:incoming>f_conflict_conflictTask</bpmn:incoming>
      <bpmn:outgoing>f_conflictTask_endConflict</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endConflict" name="A conflict task is open">
      <bpmn:incoming>f_conflictTask_endConflict</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endDropped" name="Every task dropped: unchanged">
      <bpmn:incoming>f_left_endDropped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="readyOpen" name="Open sub-issue while it waits?">
      <bpmn:incoming>f_stored_readyOpen</bpmn:incoming>
      <bpmn:outgoing>f_readyOpen_backToDev</bpmn:outgoing>
      <bpmn:outgoing>f_readyOpen_endReadyStays</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="backToDev" name="Set In Dev again">
      <bpmn:incoming>f_readyOpen_backToDev</bpmn:incoming>
      <bpmn:outgoing>f_backToDev_endBack</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endBack" name="Back in development">
      <bpmn:incoming>f_backToDev_endBack</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endReadyStays" name="Still waits for QA">
      <bpmn:incoming>f_readyOpen_endReadyStays</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="testOpen" name="Open sub-issue under test?">
      <bpmn:incoming>f_stored_testOpen</bpmn:incoming>
      <bpmn:outgoing>f_testOpen_toBlocked</bpmn:outgoing>
      <bpmn:outgoing>f_testOpen_endTestStays</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="toBlocked" name="Set Blocked">
      <bpmn:incoming>f_testOpen_toBlocked</bpmn:incoming>
      <bpmn:outgoing>f_toBlocked_endBlocked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endBlocked" name="Blocked by a fix task">
      <bpmn:incoming>f_toBlocked_endBlocked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endTestStays" name="Still in test">
      <bpmn:incoming>f_testOpen_endTestStays</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endOther" name="Done or closed: unchanged">
      <bpmn:incoming>f_stored_endOther</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_event_read" sourceRef="event" targetRef="feature_status_process_read" />
    <bpmn:sequenceFlow id="f_read_stored" sourceRef="feature_status_process_read" targetRef="stored" />
    <bpmn:sequenceFlow id="f_stored_todoOpen" name="Todo" sourceRef="stored" targetRef="todoOpen" />
    <bpmn:sequenceFlow id="f_stored_left" name="In Dev or Blocked" sourceRef="stored" targetRef="feature_status_process_left" />
    <bpmn:sequenceFlow id="f_stored_readyOpen" name="Ready For Test" sourceRef="stored" targetRef="readyOpen" />
    <bpmn:sequenceFlow id="f_stored_testOpen" name="In Test" sourceRef="stored" targetRef="testOpen" />
    <bpmn:sequenceFlow id="f_stored_endOther" name="Done" sourceRef="stored" targetRef="endOther" />
    <bpmn:sequenceFlow id="f_todoOpen_toInDev" name="yes" sourceRef="todoOpen" targetRef="toInDev" />
    <bpmn:sequenceFlow id="f_todoOpen_endTodo" name="no" sourceRef="todoOpen" targetRef="endTodo" />
    <bpmn:sequenceFlow id="f_toInDev_endSplit" sourceRef="toInDev" targetRef="endSplit" />
    <bpmn:sequenceFlow id="f_left_endWorking" name="yes" sourceRef="feature_status_process_left" targetRef="endWorking" />
    <bpmn:sequenceFlow id="f_left_sync" name="no, one completed" sourceRef="feature_status_process_left" targetRef="sync" />
    <bpmn:sequenceFlow id="f_left_endDropped" name="no, none completed" sourceRef="feature_status_process_left" targetRef="endDropped" />
    <bpmn:sequenceFlow id="f_sync_conflict" sourceRef="sync" targetRef="conflict" />
    <bpmn:sequenceFlow id="f_conflict_conflictTask" name="yes" sourceRef="conflict" targetRef="conflictTask" />
    <bpmn:sequenceFlow id="f_conflict_toReady" name="no" sourceRef="conflict" targetRef="toReady" />
    <bpmn:sequenceFlow id="f_conflictTask_endConflict" sourceRef="conflictTask" targetRef="endConflict" />
    <bpmn:sequenceFlow id="f_toReady_endReady" sourceRef="toReady" targetRef="endReady" />
    <bpmn:sequenceFlow id="f_readyOpen_backToDev" name="yes" sourceRef="readyOpen" targetRef="backToDev" />
    <bpmn:sequenceFlow id="f_readyOpen_endReadyStays" name="no" sourceRef="readyOpen" targetRef="endReadyStays" />
    <bpmn:sequenceFlow id="f_backToDev_endBack" sourceRef="backToDev" targetRef="endBack" />
    <bpmn:sequenceFlow id="f_testOpen_toBlocked" name="yes" sourceRef="testOpen" targetRef="toBlocked" />
    <bpmn:sequenceFlow id="f_testOpen_endTestStays" name="no" sourceRef="testOpen" targetRef="endTestStays" />
    <bpmn:sequenceFlow id="f_toBlocked_endBlocked" sourceRef="toBlocked" targetRef="endBlocked" />
  </bpmn:process>
  <bpmn:collaboration id="model_gate_collab">
    <bpmn:participant id="model_gate_pool" name="A change to a graph is checked" processRef="model_gate_process" />
  </bpmn:collaboration>
  <bpmn:process id="model_gate_process" name="A change to a graph is checked" isExecutable="false">
    <bpmn:laneSet id="model_gate_process_laneset">
      <bpmn:lane id="model_gate_process_lane_0" name="Agent">
        <bpmn:flowNodeRef>model_gate_process_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lintOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>model_gate_process_look</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>covered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scenario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>model_gate_process_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>model_gate_process_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>current</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="model_gate_process_lane_1" name="Review agent">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="Owner">
        <bpmn:flowNodeRef>model_gate_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>model_gate_process_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="model_gate_process_start" name="Behaviour or structure to change">
      <bpmn:outgoing>f_start_writeJoin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="writeJoin">
      <bpmn:incoming>f_start_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_lintOk_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_readable_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_findings_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_current_writeJoin</bpmn:incoming>
      <bpmn:incoming>f_clear_writeJoin</bpmn:incoming>
      <bpmn:outgoing>f_writeJoin_write</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="write" name="Edit the graph">
      <bpmn:incoming>f_writeJoin_write</bpmn:incoming>
      <bpmn:outgoing>f_write_lint</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="lint" name="Lint the graph">
      <bpmn:incoming>f_write_lint</bpmn:incoming>
      <bpmn:outgoing>f_lint_lintOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="lintOk" name="Lint clean?">
      <bpmn:incoming>f_lint_lintOk</bpmn:incoming>
      <bpmn:outgoing>f_lintOk_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_lintOk_render</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="render" name="Render the picture">
      <bpmn:incoming>f_lintOk_render</bpmn:incoming>
      <bpmn:outgoing>f_render_look</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="model_gate_process_look" name="Look at the picture">
      <bpmn:incoming>f_render_look</bpmn:incoming>
      <bpmn:outgoing>f_look_readable</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="readable" name="Readable?">
      <bpmn:incoming>f_look_readable</bpmn:incoming>
      <bpmn:outgoing>f_readable_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_readable_specJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="specJoin">
      <bpmn:incoming>f_readable_specJoin</bpmn:incoming>
      <bpmn:incoming>f_scenario_specJoin</bpmn:incoming>
      <bpmn:outgoing>f_specJoin_paths</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="paths" name="List the cover paths">
      <bpmn:incoming>f_specJoin_paths</bpmn:incoming>
      <bpmn:outgoing>f_paths_covered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="covered" name="Every cover path cited?">
      <bpmn:incoming>f_paths_covered</bpmn:incoming>
      <bpmn:outgoing>f_covered_scenario</bpmn:outgoing>
      <bpmn:outgoing>f_covered_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="scenario" name="Write the scenario for the path">
      <bpmn:incoming>f_covered_scenario</bpmn:incoming>
      <bpmn:outgoing>f_scenario_specJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="review" name="Review the graph and its pictures">
      <bpmn:incoming>f_covered_review</bpmn:incoming>
      <bpmn:outgoing>f_review_findings</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="findings" name="Findings?">
      <bpmn:incoming>f_review_findings</bpmn:incoming>
      <bpmn:outgoing>f_findings_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_findings_save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="model_gate_process_save" name="Write the edit into the graph">
      <bpmn:incoming>f_findings_save</bpmn:incoming>
      <bpmn:outgoing>f_save_check</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="model_gate_process_check" name="Check the pictures">
      <bpmn:incoming>f_save_check</bpmn:incoming>
      <bpmn:outgoing>f_check_current</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="current" name="Pictures current?">
      <bpmn:incoming>f_check_current</bpmn:incoming>
      <bpmn:outgoing>f_current_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_current_read</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="model_gate_process_read" name="Read the picture">
      <bpmn:incoming>f_current_read</bpmn:incoming>
      <bpmn:outgoing>f_read_clear</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="clear" name="Clear what we want?">
      <bpmn:incoming>f_read_clear</bpmn:incoming>
      <bpmn:outgoing>f_clear_writeJoin</bpmn:outgoing>
      <bpmn:outgoing>f_clear_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="model_gate_process_end" name="Model agreed">
      <bpmn:incoming>f_clear_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_writeJoin" sourceRef="model_gate_process_start" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_writeJoin_write" sourceRef="writeJoin" targetRef="write" />
    <bpmn:sequenceFlow id="f_write_lint" sourceRef="write" targetRef="lint" />
    <bpmn:sequenceFlow id="f_lint_lintOk" sourceRef="lint" targetRef="lintOk" />
    <bpmn:sequenceFlow id="f_lintOk_writeJoin" name="no" sourceRef="lintOk" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_lintOk_render" name="yes" sourceRef="lintOk" targetRef="render" />
    <bpmn:sequenceFlow id="f_render_look" sourceRef="render" targetRef="model_gate_process_look" />
    <bpmn:sequenceFlow id="f_look_readable" sourceRef="model_gate_process_look" targetRef="readable" />
    <bpmn:sequenceFlow id="f_readable_writeJoin" name="no" sourceRef="readable" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_readable_specJoin" name="yes" sourceRef="readable" targetRef="specJoin" />
    <bpmn:sequenceFlow id="f_specJoin_paths" sourceRef="specJoin" targetRef="paths" />
    <bpmn:sequenceFlow id="f_paths_covered" sourceRef="paths" targetRef="covered" />
    <bpmn:sequenceFlow id="f_covered_scenario" name="no" sourceRef="covered" targetRef="scenario" />
    <bpmn:sequenceFlow id="f_covered_review" name="yes" sourceRef="covered" targetRef="review" />
    <bpmn:sequenceFlow id="f_scenario_specJoin" sourceRef="scenario" targetRef="specJoin" />
    <bpmn:sequenceFlow id="f_review_findings" sourceRef="review" targetRef="findings" />
    <bpmn:sequenceFlow id="f_findings_writeJoin" name="some" sourceRef="findings" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_findings_save" name="none" sourceRef="findings" targetRef="model_gate_process_save" />
    <bpmn:sequenceFlow id="f_save_check" sourceRef="model_gate_process_save" targetRef="model_gate_process_check" />
    <bpmn:sequenceFlow id="f_check_current" sourceRef="model_gate_process_check" targetRef="current" />
    <bpmn:sequenceFlow id="f_current_writeJoin" name="no" sourceRef="current" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_current_read" name="yes" sourceRef="current" targetRef="model_gate_process_read" />
    <bpmn:sequenceFlow id="f_read_clear" sourceRef="model_gate_process_read" targetRef="clear" />
    <bpmn:sequenceFlow id="f_clear_writeJoin" name="no" sourceRef="clear" targetRef="writeJoin" />
    <bpmn:sequenceFlow id="f_clear_end" name="yes" sourceRef="clear" targetRef="model_gate_process_end" />
  </bpmn:process>
  <bpmn:collaboration id="simplify_collab">
    <bpmn:participant id="simplify_pool" name="A model is simplified on request" processRef="simplify_process" />
  </bpmn:collaboration>
  <bpmn:process id="simplify_process" name="A model is simplified on request" isExecutable="false">
    <bpmn:laneSet id="simplify_process_laneset">
      <bpmn:lane id="simplify_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>simplify_process_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>simplify_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>left</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="simplify_process_lane_1" name="Simplify agent">
        <bpmn:flowNodeRef>firstJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tryFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>againFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nothing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moreJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>againMore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tryMore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="simplify_process_ask" name="The owner asks to simplify a model">
      <bpmn:outgoing>f_ask_firstJoin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="firstJoin">
      <bpmn:incoming>f_ask_firstJoin</bpmn:incoming>
      <bpmn:incoming>f_againFirst_firstJoin</bpmn:incoming>
      <bpmn:outgoing>f_firstJoin_tryFirst</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="tryFirst" name="Try one rewrite" calledElement="try_rewrite_process">
      <bpmn:incoming>f_firstJoin_tryFirst</bpmn:incoming>
      <bpmn:outgoing>f_tryFirst_result</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="result" name="Rewrite kept?">
      <bpmn:incoming>f_tryFirst_result</bpmn:incoming>
      <bpmn:outgoing>f_result_moreJoin</bpmn:outgoing>
      <bpmn:outgoing>f_result_againFirst</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="againFirst" name="Another rewrite to try?">
      <bpmn:incoming>f_result_againFirst</bpmn:incoming>
      <bpmn:outgoing>f_againFirst_firstJoin</bpmn:outgoing>
      <bpmn:outgoing>f_againFirst_nothing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="nothing" name="Nothing to simplify">
      <bpmn:incoming>f_againFirst_nothing</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="moreJoin">
      <bpmn:incoming>f_result_moreJoin</bpmn:incoming>
      <bpmn:incoming>f_tryMore_moreJoin</bpmn:incoming>
      <bpmn:outgoing>f_moreJoin_againMore</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="againMore" name="Another rewrite to try?">
      <bpmn:incoming>f_moreJoin_againMore</bpmn:incoming>
      <bpmn:outgoing>f_againMore_tryMore</bpmn:outgoing>
      <bpmn:outgoing>f_againMore_report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="tryMore" name="Try one more rewrite" calledElement="try_rewrite_process">
      <bpmn:incoming>f_againMore_tryMore</bpmn:incoming>
      <bpmn:outgoing>f_tryMore_moreJoin</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="report" name="Report kept and dropped rewrites">
      <bpmn:incoming>f_againMore_report</bpmn:incoming>
      <bpmn:outgoing>f_report_read</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="simplify_process_read" name="Read the report">
      <bpmn:incoming>f_report_read</bpmn:incoming>
      <bpmn:outgoing>f_read_take</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="take" name="Take the simplified model?">
      <bpmn:incoming>f_read_take</bpmn:incoming>
      <bpmn:outgoing>f_take_taken</bpmn:outgoing>
      <bpmn:outgoing>f_take_left</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="taken" name="Model simplified">
      <bpmn:incoming>f_take_taken</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="left" name="Model unchanged">
      <bpmn:incoming>f_take_left</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_ask_firstJoin" sourceRef="simplify_process_ask" targetRef="firstJoin" />
    <bpmn:sequenceFlow id="f_firstJoin_tryFirst" sourceRef="firstJoin" targetRef="tryFirst" />
    <bpmn:sequenceFlow id="f_tryFirst_result" sourceRef="tryFirst" targetRef="result" />
    <bpmn:sequenceFlow id="f_result_moreJoin" name="Rewrite kept" sourceRef="result" targetRef="moreJoin" />
    <bpmn:sequenceFlow id="f_result_againFirst" name="Rewrite dropped" sourceRef="result" targetRef="againFirst" />
    <bpmn:sequenceFlow id="f_againFirst_firstJoin" name="yes" sourceRef="againFirst" targetRef="firstJoin" />
    <bpmn:sequenceFlow id="f_againFirst_nothing" name="no" sourceRef="againFirst" targetRef="nothing" />
    <bpmn:sequenceFlow id="f_moreJoin_againMore" sourceRef="moreJoin" targetRef="againMore" />
    <bpmn:sequenceFlow id="f_againMore_tryMore" name="yes" sourceRef="againMore" targetRef="tryMore" />
    <bpmn:sequenceFlow id="f_againMore_report" name="no" sourceRef="againMore" targetRef="report" />
    <bpmn:sequenceFlow id="f_tryMore_moreJoin" sourceRef="tryMore" targetRef="moreJoin" />
    <bpmn:sequenceFlow id="f_report_read" sourceRef="report" targetRef="simplify_process_read" />
    <bpmn:sequenceFlow id="f_read_take" sourceRef="simplify_process_read" targetRef="take" />
    <bpmn:sequenceFlow id="f_take_taken" name="yes" sourceRef="take" targetRef="taken" />
    <bpmn:sequenceFlow id="f_take_left" name="no" sourceRef="take" targetRef="left" />
  </bpmn:process>
  <bpmn:collaboration id="try_rewrite_collab">
    <bpmn:participant id="try_rewrite_pool" name="Try one rewrite" processRef="try_rewrite_process" />
  </bpmn:collaboration>
  <bpmn:process id="try_rewrite_process" name="Try one rewrite" isExecutable="false">
    <bpmn:laneSet id="try_rewrite_process_laneset">
      <bpmn:lane id="try_rewrite_process_lane_0" name="Simplify agent">
        <bpmn:flowNodeRef>try_rewrite_process_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>try_rewrite_process_kept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="try_rewrite_process_lane_1" name="Review agent">
        <bpmn:flowNodeRef>try_rewrite_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>right</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="try_rewrite_process_start" name="A rewrite to try">
      <bpmn:outgoing>f_start_propose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="propose" name="Propose one rewrite">
      <bpmn:incoming>f_start_propose</bpmn:incoming>
      <bpmn:outgoing>f_propose_check</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="check" name="Compare signatures, C4 and measures">
      <bpmn:incoming>f_propose_check</bpmn:incoming>
      <bpmn:outgoing>f_check_ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ok" name="Signatures kept and no measure worse?">
      <bpmn:incoming>f_check_ok</bpmn:incoming>
      <bpmn:outgoing>f_ok_read</bpmn:outgoing>
      <bpmn:outgoing>f_ok_dropJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="try_rewrite_process_read" name="Read the changed activities">
      <bpmn:incoming>f_ok_read</bpmn:incoming>
      <bpmn:outgoing>f_read_right</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="right" name="Activities still say what the spec says?">
      <bpmn:incoming>f_read_right</bpmn:incoming>
      <bpmn:outgoing>f_right_keep</bpmn:outgoing>
      <bpmn:outgoing>f_right_dropJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="keep" name="Keep the rewrite">
      <bpmn:incoming>f_right_keep</bpmn:incoming>
      <bpmn:outgoing>f_keep_kept</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="dropJoin">
      <bpmn:incoming>f_ok_dropJoin</bpmn:incoming>
      <bpmn:incoming>f_right_dropJoin</bpmn:incoming>
      <bpmn:outgoing>f_dropJoin_drop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="drop" name="Drop the rewrite">
      <bpmn:incoming>f_dropJoin_drop</bpmn:incoming>
      <bpmn:outgoing>f_drop_dropped</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="try_rewrite_process_kept" name="Rewrite kept">
      <bpmn:incoming>f_keep_kept</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="dropped" name="Rewrite dropped">
      <bpmn:incoming>f_drop_dropped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_propose" sourceRef="try_rewrite_process_start" targetRef="propose" />
    <bpmn:sequenceFlow id="f_propose_check" sourceRef="propose" targetRef="check" />
    <bpmn:sequenceFlow id="f_check_ok" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f_ok_read" name="yes" sourceRef="ok" targetRef="try_rewrite_process_read" />
    <bpmn:sequenceFlow id="f_ok_dropJoin" name="no" sourceRef="ok" targetRef="dropJoin" />
    <bpmn:sequenceFlow id="f_read_right" sourceRef="try_rewrite_process_read" targetRef="right" />
    <bpmn:sequenceFlow id="f_right_keep" name="yes" sourceRef="right" targetRef="keep" />
    <bpmn:sequenceFlow id="f_right_dropJoin" name="no" sourceRef="right" targetRef="dropJoin" />
    <bpmn:sequenceFlow id="f_keep_kept" sourceRef="keep" targetRef="try_rewrite_process_kept" />
    <bpmn:sequenceFlow id="f_dropJoin_drop" sourceRef="dropJoin" targetRef="drop" />
    <bpmn:sequenceFlow id="f_drop_dropped" sourceRef="drop" targetRef="dropped" />
  </bpmn:process>
  <bpmn:collaboration id="docs_delete_collab">
    <bpmn:participant id="docs_delete_pool" name="A snapshot is deleted by the owner only" processRef="docs_delete_process" />
  </bpmn:collaboration>
  <bpmn:process id="docs_delete_process" name="A snapshot is deleted by the owner only" isExecutable="false">
    <bpmn:laneSet id="docs_delete_process_laneset">
      <bpmn:lane id="docs_delete_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>want</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="docs_delete_process_lane_1" name="Agent">
        <bpmn:flowNodeRef>docs_delete_process_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="docs_delete_process_start" name="A snapshot looks unwanted">
      <bpmn:outgoing>f_start_run</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="run" name="1 Run qsm-docs delete">
      <bpmn:incoming>f_start_run</bpmn:incoming>
      <bpmn:outgoing>f_run_deny</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deny" name="2 Deny the call">
      <bpmn:incoming>f_run_deny</bpmn:incoming>
      <bpmn:outgoing>f_deny_ask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="ask" name="3 Ask the owner to delete it">
      <bpmn:incoming>f_deny_ask</bpmn:incoming>
      <bpmn:outgoing>f_ask_want</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="want" name="Delete it?">
      <bpmn:incoming>f_ask_want</bpmn:incoming>
      <bpmn:outgoing>f_want_kept</bpmn:outgoing>
      <bpmn:outgoing>f_want_del</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="kept" name="Snapshot kept">
      <bpmn:incoming>f_want_kept</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="del" name="4 Run the delete with !">
      <bpmn:incoming>f_want_del</bpmn:incoming>
      <bpmn:outgoing>f_del_gone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="gone" name="Snapshot deleted">
      <bpmn:incoming>f_del_gone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_run" sourceRef="docs_delete_process_start" targetRef="run" />
    <bpmn:sequenceFlow id="f_run_deny" sourceRef="run" targetRef="deny" />
    <bpmn:sequenceFlow id="f_deny_ask" sourceRef="deny" targetRef="ask" />
    <bpmn:sequenceFlow id="f_ask_want" sourceRef="ask" targetRef="want" />
    <bpmn:sequenceFlow id="f_want_kept" name="no" sourceRef="want" targetRef="kept" />
    <bpmn:sequenceFlow id="f_want_del" name="yes" sourceRef="want" targetRef="del" />
    <bpmn:sequenceFlow id="f_del_gone" sourceRef="del" targetRef="gone" />
  </bpmn:process>
  <bpmn:collaboration id="docs_proposal_collab">
    <bpmn:participant id="docs_proposal_pool" name="An edit on a page becomes a proposal" processRef="docs_proposal_process" />
  </bpmn:collaboration>
  <bpmn:process id="docs_proposal_process" name="An edit on a page becomes a proposal" isExecutable="false">
    <bpmn:laneSet id="docs_proposal_process_laneset">
      <bpmn:lane id="docs_proposal_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>docs_proposal_process_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_save</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="docs_proposal_process_lane_1" name="Agent">
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_say</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_proposal_process_open_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="docs_proposal_process_start" name="Document to change">
      <bpmn:outgoing>docs_proposal_process_f_start_open</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="docs_proposal_process_open" name="1 Open the page of the document">
      <bpmn:incoming>docs_proposal_process_f_start_open</bpmn:incoming>
      <bpmn:outgoing>f_open_edit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="docs_proposal_process_edit" name="2 Edit the document in edit mode">
      <bpmn:incoming>f_open_edit</bpmn:incoming>
      <bpmn:outgoing>f_edit_save</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="docs_proposal_process_save" name="3 Save the edit as a proposal">
      <bpmn:incoming>f_edit_save</bpmn:incoming>
      <bpmn:outgoing>f_save_tell</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="tell" name="4 Name the proposal in the next prompt">
      <bpmn:incoming>f_save_tell</bpmn:incoming>
      <bpmn:outgoing>f_tell_read</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="docs_proposal_process_read" name="5 Read the proposal and its diff">
      <bpmn:incoming>f_tell_read</bpmn:incoming>
      <bpmn:outgoing>f_read_clean</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="clean" name="Applies cleanly?">
      <bpmn:incoming>f_read_clean</bpmn:incoming>
      <bpmn:outgoing>f_clean_apply</bpmn:outgoing>
      <bpmn:outgoing>f_clean_say</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="docs_proposal_process_apply" name="6 Create the applied snapshot">
      <bpmn:incoming>f_clean_apply</bpmn:incoming>
      <bpmn:outgoing>f_apply_applied</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="docs_proposal_process_applied" name="Proposal applied">
      <bpmn:incoming>f_apply_applied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="docs_proposal_process_say" name="7 Tell the owner what blocks it">
      <bpmn:incoming>f_clean_say</bpmn:incoming>
      <bpmn:outgoing>docs_proposal_process_f_say_open_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="docs_proposal_process_open_end" name="Proposal still open">
      <bpmn:incoming>docs_proposal_process_f_say_open_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="docs_proposal_process_f_start_open" sourceRef="docs_proposal_process_start" targetRef="docs_proposal_process_open" />
    <bpmn:sequenceFlow id="f_open_edit" sourceRef="docs_proposal_process_open" targetRef="docs_proposal_process_edit" />
    <bpmn:sequenceFlow id="f_edit_save" sourceRef="docs_proposal_process_edit" targetRef="docs_proposal_process_save" />
    <bpmn:sequenceFlow id="f_save_tell" sourceRef="docs_proposal_process_save" targetRef="tell" />
    <bpmn:sequenceFlow id="f_tell_read" sourceRef="tell" targetRef="docs_proposal_process_read" />
    <bpmn:sequenceFlow id="f_read_clean" sourceRef="docs_proposal_process_read" targetRef="clean" />
    <bpmn:sequenceFlow id="f_clean_apply" name="yes" sourceRef="clean" targetRef="docs_proposal_process_apply" />
    <bpmn:sequenceFlow id="f_clean_say" name="no" sourceRef="clean" targetRef="docs_proposal_process_say" />
    <bpmn:sequenceFlow id="f_apply_applied" sourceRef="docs_proposal_process_apply" targetRef="docs_proposal_process_applied" />
    <bpmn:sequenceFlow id="docs_proposal_process_f_say_open_end" sourceRef="docs_proposal_process_say" targetRef="docs_proposal_process_open_end" />
  </bpmn:process>
  <bpmn:collaboration id="edit_graph_collab">
    <bpmn:participant id="edit_graph_pool" name="The owner changes a graph on its page" processRef="edit_graph_process" />
  </bpmn:collaboration>
  <bpmn:process id="edit_graph_process" name="The owner changes a graph on its page" isExecutable="false">
    <bpmn:laneSet id="edit_graph_process_laneset">
      <bpmn:lane id="edit_graph_process_lane_0" name="Owner">
        <bpmn:flowNodeRef>edit_graph_process_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit_graph_process_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>editJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="edit_graph_process_lane_1" name="Agent">
        <bpmn:flowNodeRef>edit_graph_process_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit_graph_process_say</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="edit_graph_process_start" name="Graph to change">
      <bpmn:outgoing>f_start_open</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="edit_graph_process_open" name="1 Open the graph page">
      <bpmn:incoming>f_start_open</bpmn:incoming>
      <bpmn:outgoing>f_open_editJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="editJoin">
      <bpmn:incoming>f_open_editJoin</bpmn:incoming>
      <bpmn:incoming>f_legal_editJoin</bpmn:incoming>
      <bpmn:outgoing>f_editJoin_edit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="edit" name="2 Move, rename or comment">
      <bpmn:incoming>f_editJoin_edit</bpmn:incoming>
      <bpmn:outgoing>f_edit_legal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="legal" name="Edit kept?">
      <bpmn:incoming>f_edit_legal</bpmn:incoming>
      <bpmn:outgoing>f_legal_save</bpmn:outgoing>
      <bpmn:outgoing>f_legal_editJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="save" name="3 Save the proposal">
      <bpmn:incoming>f_legal_save</bpmn:incoming>
      <bpmn:outgoing>f_save_read</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="edit_graph_process_read" name="4 Read the proposal and its diff">
      <bpmn:incoming>f_save_read</bpmn:incoming>
      <bpmn:outgoing>f_read_apply</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="apply" name="5 Apply it to the graph">
      <bpmn:incoming>f_read_apply</bpmn:incoming>
      <bpmn:outgoing>f_apply_gates</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="gates" name="6 Run the gates">
      <bpmn:incoming>f_apply_gates</bpmn:incoming>
      <bpmn:outgoing>f_gates_pass</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="pass" name="Gates pass?">
      <bpmn:incoming>f_gates_pass</bpmn:incoming>
      <bpmn:outgoing>f_pass_create</bpmn:outgoing>
      <bpmn:outgoing>f_pass_say</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="create" name="7 Create the applied snapshot">
      <bpmn:incoming>f_pass_create</bpmn:incoming>
      <bpmn:outgoing>f_create_applied</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="applied" name="Proposal applied">
      <bpmn:incoming>f_create_applied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="edit_graph_process_say" name="8 Tell the owner what failed">
      <bpmn:incoming>f_pass_say</bpmn:incoming>
      <bpmn:outgoing>f_say_open_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="open_end" name="Proposal still open">
      <bpmn:incoming>f_say_open_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_open" sourceRef="edit_graph_process_start" targetRef="edit_graph_process_open" />
    <bpmn:sequenceFlow id="f_open_editJoin" sourceRef="edit_graph_process_open" targetRef="editJoin" />
    <bpmn:sequenceFlow id="f_editJoin_edit" sourceRef="editJoin" targetRef="edit" />
    <bpmn:sequenceFlow id="f_edit_legal" sourceRef="edit" targetRef="legal" />
    <bpmn:sequenceFlow id="f_legal_save" name="yes" sourceRef="legal" targetRef="save" />
    <bpmn:sequenceFlow id="f_legal_editJoin" name="snapped back" sourceRef="legal" targetRef="editJoin" />
    <bpmn:sequenceFlow id="f_save_read" sourceRef="save" targetRef="edit_graph_process_read" />
    <bpmn:sequenceFlow id="f_read_apply" sourceRef="edit_graph_process_read" targetRef="apply" />
    <bpmn:sequenceFlow id="f_apply_gates" sourceRef="apply" targetRef="gates" />
    <bpmn:sequenceFlow id="f_gates_pass" sourceRef="gates" targetRef="pass" />
    <bpmn:sequenceFlow id="f_pass_create" name="yes" sourceRef="pass" targetRef="create" />
    <bpmn:sequenceFlow id="f_pass_say" name="no" sourceRef="pass" targetRef="edit_graph_process_say" />
    <bpmn:sequenceFlow id="f_create_applied" sourceRef="create" targetRef="applied" />
    <bpmn:sequenceFlow id="f_say_open_end" sourceRef="edit_graph_process_say" targetRef="open_end" />
  </bpmn:process>
  <bpmn:collaboration id="pr_pictures_collab">
    <bpmn:participant id="pr_pictures_pool" name="A PR shows what its change does to the graphs" processRef="pr_pictures_process" />
  </bpmn:collaboration>
  <bpmn:process id="pr_pictures_process" name="A PR shows what its change does to the graphs" isExecutable="false">
    <bpmn:laneSet id="laneset">
      <bpmn:lane id="lane_0" name="Owner">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Agent">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>touched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>say</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drawJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>look</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>openJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Change ready for its PR">
      <bpmn:outgoing>f_start_find</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="find" name="1 Find what the change touches">
      <bpmn:incoming>f_start_find</bpmn:incoming>
      <bpmn:outgoing>f_find_touched</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="touched" name="Touches a graph?">
      <bpmn:incoming>f_find_touched</bpmn:incoming>
      <bpmn:outgoing>f_touched_say</bpmn:outgoing>
      <bpmn:outgoing>f_touched_drawJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="say" name="5 Say it touches neither graph">
      <bpmn:incoming>f_touched_say</bpmn:incoming>
      <bpmn:outgoing>f_say_openJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="drawJoin">
      <bpmn:incoming>f_touched_drawJoin</bpmn:incoming>
      <bpmn:incoming>f_widen_drawJoin</bpmn:incoming>
      <bpmn:outgoing>f_drawJoin_draw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="draw" name="2 Draw the before and the after">
      <bpmn:incoming>f_drawJoin_draw</bpmn:incoming>
      <bpmn:outgoing>f_draw_look</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="look" name="3 Look at the pictures">
      <bpmn:incoming>f_draw_look</bpmn:incoming>
      <bpmn:outgoing>f_look_enough</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="enough" name="Enough to understand?">
      <bpmn:incoming>f_look_enough</bpmn:incoming>
      <bpmn:outgoing>f_enough_openJoin</bpmn:outgoing>
      <bpmn:outgoing>f_enough_widen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="widen" name="4 Widen the subgraph">
      <bpmn:incoming>f_enough_widen</bpmn:incoming>
      <bpmn:outgoing>f_widen_drawJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="openJoin">
      <bpmn:incoming>f_enough_openJoin</bpmn:incoming>
      <bpmn:incoming>f_say_openJoin</bpmn:incoming>
      <bpmn:outgoing>f_openJoin_open</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="open" name="6 Open the PR">
      <bpmn:incoming>f_openJoin_open</bpmn:incoming>
      <bpmn:outgoing>f_open_read</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="read" name="7 Read the change in the PR">
      <bpmn:incoming>f_open_read</bpmn:incoming>
      <bpmn:outgoing>f_read_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Change read">
      <bpmn:incoming>f_read_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_find" sourceRef="start" targetRef="find" />
    <bpmn:sequenceFlow id="f_find_touched" sourceRef="find" targetRef="touched" />
    <bpmn:sequenceFlow id="f_touched_say" name="no" sourceRef="touched" targetRef="say" />
    <bpmn:sequenceFlow id="f_touched_drawJoin" name="yes" sourceRef="touched" targetRef="drawJoin" />
    <bpmn:sequenceFlow id="f_drawJoin_draw" sourceRef="drawJoin" targetRef="draw" />
    <bpmn:sequenceFlow id="f_draw_look" sourceRef="draw" targetRef="look" />
    <bpmn:sequenceFlow id="f_look_enough" sourceRef="look" targetRef="enough" />
    <bpmn:sequenceFlow id="f_enough_openJoin" name="yes" sourceRef="enough" targetRef="openJoin" />
    <bpmn:sequenceFlow id="f_enough_widen" name="no" sourceRef="enough" targetRef="widen" />
    <bpmn:sequenceFlow id="f_widen_drawJoin" sourceRef="widen" targetRef="drawJoin" />
    <bpmn:sequenceFlow id="f_say_openJoin" sourceRef="say" targetRef="openJoin" />
    <bpmn:sequenceFlow id="f_openJoin_open" sourceRef="openJoin" targetRef="open" />
    <bpmn:sequenceFlow id="f_open_read" sourceRef="open" targetRef="read" />
    <bpmn:sequenceFlow id="f_read_end" sourceRef="read" targetRef="end" />
  </bpmn:process>
