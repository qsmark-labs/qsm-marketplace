#!/usr/bin/env bash
# installed by qsm-langdev
# Remove with: qsm-langdev uninstall
set -euo pipefail

# git hands the pushed refs on stdin once; keep them so qsm-langdev and the gates below both read them.
pushed_refs=$(mktemp)
scratch=$(mktemp -d)
trap 'rm -rf "$pushed_refs" "$scratch"' EXIT
cat >"$pushed_refs"
exec <"$pushed_refs"

qsm-langdev hook pre-push "${1:-}" || exit 1

# A fresh worktree has no node_modules, and the gates below then fail with type errors that hide
# the cause. Root `bun install` runs the prepare script (core.hooksPath and .gates/plugin-deps.ts,
# which installs each plugin's own dependencies), so one install fixes every case.
missing_node_modules() {
  local dir
  for dir in . plugins/*/; do
    if [[ -f "$dir/package.json" && ! -d "$dir/node_modules" ]]; then
      echo "pre-push: node_modules is missing in $dir, run: mise exec -- bun install (its prepare script also installs each plugin's dependencies)" >&2
      return 1
    fi
  done
}
missing_node_modules || exit 1

# `bun check` arrived in Bun 1.4; an older bun says only "Script not found".
if ! bun check --help >/dev/null 2>&1; then
  echo "pre-push: bun $(bun --version) has no 'bun check'; mise.toml pins the version, run: mise install" >&2
  exit 1
fi

# The marketplace's own gates, repo-specific, so nothing outside a langdev checker (the generated
# contracts, every plugin's hooks tsconfig against .claude/types) reaches origin red. They judge
# each pushed commit, never this directory: a file not yet committed here is not pushed, so it can
# neither pass nor block the push. The commit is unpacked into a scratch directory and borrows this
# tree's node_modules.
gate_commit() {
  local sha=$1 dir="$scratch/$1" deps
  # Called left of `||`, where bash ignores set -e, so every step that can fail returns by hand.
  mkdir "$dir" || return 1
  # read-tree and checkout-index write every tracked file; git archive would drop the export-ignore
  # ones, the generated nouns the hooks modules import.
  GIT_INDEX_FILE="$dir.index" git read-tree "$sha" || return 1
  GIT_INDEX_FILE="$dir.index" git checkout-index -a --prefix="$dir/" || return 1
  for deps in node_modules plugins/*/node_modules; do
    if [[ -d "$deps" && -d "$dir/$(dirname "$deps")" ]]; then
      ln -s "$PWD/$deps" "$dir/$deps" || return 1
    fi
  done
  echo "pre-push: gates on ${sha:0:8}" >&2
  # .claude/types is gitignored and copied from the engine, so a commit never carries it.
  (cd "$dir" && bun run validate && bun run plugin-types >/dev/null && bun run typecheck)
}

declare -A gated=()
while read -r _ local_sha _ _; do
  # A deleted ref pushes no commit.
  if [[ $local_sha =~ ^0+$ || -n ${gated[$local_sha]:-} ]]; then
    continue
  fi
  gated[$local_sha]=1
  gate_commit "$local_sha" || exit 1
done <"$pushed_refs"

# The size check of the pull request this branch becomes, run before it exists. Its base is the
# branch it was cut from, the one whose merge base is nearest to the pushed commit: origin/main,
# every origin/feature/*, or a task branch whose tip the commit already holds, so a branch stacked
# on another task's branch counts only its own lines. A sibling branch is never a base, because it
# shares history without being where this one started. main and feature/* are bases themselves and
# are not measured.
nearest_base() {
  local sha=$1 own=$2 best="" best_count="" candidate count
  for candidate in $(git for-each-ref --format='%(refname:short)' refs/remotes/origin/); do
    if [[ $candidate != origin/main && $candidate != origin/feature/* ]]; then
      [[ $candidate == origin/HEAD || $candidate == origin || $candidate == "origin/$own" ]] && continue
      git merge-base --is-ancestor "$candidate" "$sha" || continue
    fi
    count=$(git rev-list --count "$(git merge-base "$candidate" "$sha")..$sha") || return 1
    if [[ -z $best_count || $count -lt $best_count ]]; then
      best=$candidate best_count=$count
    fi
  done
  [[ -n $best ]] || {
    echo "pre-push: no origin/main to measure the pull request size against" >&2
    return 1
  }
  echo "$best"
}

# A merge whose every parent is already on origin/main or an origin/feature/* (main taken into a
# feature branch) brings only lines reviewed where they landed, so it has none of its own.
merges_bases() {
  local parent base
  for parent in $(git rev-list --parents -n 1 "$1" | cut -d' ' -f2-); do
    for base in $(git for-each-ref --format='%(refname:short)' refs/remotes/origin/main 'refs/remotes/origin/feature/*'); do
      git merge-base --is-ancestor "$parent" "$base" && continue 2
    done
    return 1
  done
  [[ $(git rev-list --parents -n 1 "$1" | wc -w) -gt 2 ]]
}

while read -r _ local_sha remote_ref _; do
  if [[ $local_sha =~ ^0+$ || $remote_ref == refs/heads/main || $remote_ref == refs/heads/feature/* ]]; then
    continue
  fi
  if merges_bases "$local_sha"; then
    echo "pre-push: ${remote_ref#refs/heads/} merges reviewed bases, nothing of its own to measure" >&2
    continue
  fi
  base=$(nearest_base "$local_sha" "${remote_ref#refs/heads/}") || exit 1
  echo "pre-push: pull request size of ${remote_ref#refs/heads/} against $base" >&2
  .gates/pr-size.sh "$base" "$local_sha" >&2 || exit 1
done <"$pushed_refs"
